local function hopServer()
    isRunning = false
    StatusLabel.Text = "Hopping Server..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    
    local currentPlaceId = game.PlaceId
    local currentJobId = game.JobId
    local url = "https://games.roblox.com/v1/games/" .. currentPlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= currentJobId then
                local args = {
                    [1] = "teleport",
                    [2] = tostring(server.id)
                }
                
                if serverBrowser then
                    local tpSuccess = pcall(function()
                        serverBrowser:InvokeServer(unpack(args))
                    end)
                    if tpSuccess then 
                        task.wait(2) 
                        return 
                    end
                else
                    local tpSuccess = pcall(function()
                        TeleportService:TeleportToPlaceInstance(currentPlaceId, tostring(server.id), player)
                    end)
                    if tpSuccess then 
                        return 
                    end
                end
            end
        end
    end
    
    pcall(function()
        if serverBrowser then
            serverBrowser:InvokeServer("teleport")
        else
            TeleportService:Teleport(currentPlaceId, player)
        end
    end)
end

local function storeFruit(item)
    pcall(function()
        if item and item:IsA("Tool") then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rawName = item.Name:gsub(" Fruit", "")
            
            if AllBloxFruits[rawName] or string.find(item.Name, "Fruit") then
                local uniqueId = item:GetDebugId()
                if not storedFruitsCache[uniqueId] then
                    storedFruitsCache[uniqueId] = true
                    if item.Parent == player.Backpack and humanoid then
                        humanoid:EquipTool(item)
                        task.wait(0.2)
                    end
                    if remoteComm then
                        remoteComm:InvokeServer("StoreFruit", AllBloxFruits[rawName] or (rawName .. "-" .. rawName), item)
                    end
                end
            end
        end
    end)
end

local function storeAllOwnedFruits()
    pcall(function()
        if player.Character then
            for _, item in ipairs(player.Character:GetChildren()) do
                storeFruit(item)
            end
        end
        if player:FindFirstChild("Backpack") then
            for _, item in ipairs(player.Backpack:GetChildren()) do
                storeFruit(item)
            end
        end
    end)
end

local function autoPickAndStore()
    storeAllOwnedFruits()
    local found = false
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            local rawName = obj.Name:gsub(" Fruit", "")
            if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                local handle = obj:FindFirstChild("Handle")
                local character = player.Character
                if handle and character and character:FindFirstChild("HumanoidRootPart") then
                    local targetCFrame = handle.CFrame + Vector3.new(0, 3, 0)
                    
                    if moveType == "tween" then
                        StatusLabel.Text = "Tween: " .. obj.Name
                        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                        
                        local hrp = character:FindFirstChild("HumanoidRootPart")
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        
                        if hrp and humanoid then
                            humanoid.PlatformStand = true
                            
                            local startCFrame = hrp.CFrame
                            local distance = (startCFrame.Position - targetCFrame.Position).Magnitude
                            local speed = 300
                            local duration = distance / speed
                            local startTime = tick()
                            
                            local conn
                            conn = RunService.Stepped:Connect(function()
                                if not isRunning or not character:FindFirstChild("HumanoidRootPart") then
                                    if conn then conn:Disconnect() end
                                    return
                                end
                                
                                for _, part in ipairs(character:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.CanCollide = false
                                    end
                                end
                                
                                local elapsed = tick() - startTime
                                local alpha = math.clamp(elapsed / duration, 0, 1)
                                
                                hrp.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                
                                if alpha >= 1 then
                                    if conn then conn:Disconnect() end
                                end
                            end)
                            
                            task.wait(duration)
                            if conn then conn:Disconnect() end
                            humanoid.PlatformStand = false
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                    else
                        StatusLabel.Text = "Fast TP: " .. obj.Name
                        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                        character.HumanoidRootPart.CFrame = targetCFrame
                        task.wait(0.15)
                    end
                    
                    storeAllOwnedFruits()
                    found = true
                    break
                end
            end
        end
    end)
    return found
end

-- Launch directly into the main auto-farm loop without key verification or webhooks
task.spawn(function()
    isRunning = true
    
    task.spawn(function()
        while true do
            isRunning = true
            StatusLabel.Text = "Team: " .. factionDisplayName
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            local attempts = 0
            repeat
                pcall(function()
                    if remoteComm then
                        remoteComm:InvokeServer("SetTeam", chosenFaction)
                    end
                end)
                task.wait(1)
                attempts = attempts + 1
            until (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position.Magnitude > 50) or attempts > 12 or not isRunning

            if not isRunning then break end

            StatusLabel.Text = "Ready!"
            task.wait(0.5)

            local scanStart = tick()
            while isRunning do
                StatusLabel.Text = "Scanning..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                
                local collected = false
                pcall(function()
                    collected = autoPickAndStore()
                end)
                
                if collected then
                    scanStart = tick()
                end
                
                if not collected and (tick() - scanStart > 3) then
                    StatusLabel.Text = "Not found (Hopping...)"
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                    task.wait(0.5)
                    break
                end
                
                if not isRunning then break end
                task.wait(0.2)
            end

            if not isRunning then break end
            hopServer()
            task.wait(3)
        end
    end)
end)
