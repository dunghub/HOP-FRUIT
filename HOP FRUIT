local HWID = game:GetService("RbxAnalyticsService"):GetClientId()
local KEY_CACHE_FILE = "DuboHub_KeyCache.json"
local GITHUB_KEY_URL = "https://raw.githubusercontent.com/YOUR_GITHUB_USER/YOUR_REPO/main/keys.txt/" .. HWID

local function getSavedKeyCache()
    if readfile and isfile and isfile(KEY_CACHE_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(KEY_CACHE_FILE))
        end)
        if success and data and data.HWID == HWID then
            if os.time() - (data.Timestamp or 0) < 86400 then -- Kho chính 24 giờ
                return data.Key
            end
        end
    end
    return nil
end

local function saveKeyCache(key)
    if writefile then
        pcall(function()
            local data = {
                HWID = HWID,
                Key = key,
                Timestamp = os.time()
            }
            writefile(KEY_CACHE_FILE, HttpService:JSONEncode(data))
        end)
    end
end

local function verifyKeyWithGitHub(inputKey)
    local success, res = pcall(function()
        if game:HttpGet then
            return game:HttpGet(GITHUB_KEY_URL)
        end
    end)
    if success and res then
        for line in res:gmatch("[^\r\n]+") do
            if line == inputKey or line:match("^" .. inputKey) then
                return true
            end
        end
    end
    return false
end

