-- Hàm gửi Discord webhook dùng chung một link ảnh duy nhất
local function sendDiscordWebhook(fruitName, uniqueId)
    if not DuboCFG.WebhookURL or DuboCFG.WebhookURL == "" then return end
    if storedFruitsCache[uniqueId] then return end
    storedFruitsCache[uniqueId] = true
    
    local maskedName = "||" .. player.Name .. "||"
    -- Dùng chung một link ảnh duy nhất cho cả avatar bot, icon góc trên và thumbnail góc phải
    local sharedImage = "https://cdn.discordapp.com/attachments/1530612413966188584/1543286088569725008/IMG_1011.png"
    
    local cleanFruitName = fruitName:gsub(" Fruit", "")
    
    local data = {
        ["content"] = "@everyone",
        ["username"] = "DUBO KAITUN FRUIT",
        ["avatar_url"] = sharedImage,
        ["embeds"] = {{
            ["color"] = 3447003,
            ["author"] = {
                ["name"] = "DUBO KAITUN FRUIT Notification",
                ["icon_url"] = sharedImage
            },
            ["thumbnail"] = {
                ["url"] = sharedImage
            },
            ["fields"] = {
                {
                    ["name"] = "Main Status",
                    ["value"] = "Username : " .. maskedName,
                    ["inline"] = false
                },
                {
                    ["name"] = "Status",
                    ["value"] = "`STORE FRUIT`",
                    ["inline"] = false
                },
                {
                    ["name"] = "Fruit",
                    ["value"] = "`" .. cleanFruitName .. "`",
                    ["inline"] = false
                }
            },
            ["footer"] = {
                ["text"] = "DUBO KAITUN FRUIT • " .. os.date("%H:%M - %d/%m/%Y"),
                ["icon_url"] = sharedImage
            }
        }}
    }
    
    local encodedData = HttpService:JSONEncode(data)
    local headers = {["Content-Type"] = "application/json"}
    
    pcall(function()
        local req = request or http_request or syn.request or fluxus.request
        if req then
            req({Url = DuboCFG.WebhookURL, Method = "POST", Headers = headers, Body = encodedData})
        else
            HttpService:PostAsync(DuboCFG.WebhookURL, encodedData)
        end
    end)
end

