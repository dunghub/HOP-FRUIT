    local function generateRandomKey(length)
        local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        local key = "DUBO-KEY-"
        math.randomseed(tick() + math.random(1000, 999999))
        for i = 1, length do
            local randIndex = math.random(1, #chars)
            key = key .. chars:sub(randIndex, randIndex)
        end
        return key
    end

    cachedGeneratedKey = generateRandomKey(14)
    targetUrl = "https://authtool.app/get-key/?result=" .. cachedGeneratedKey
