-- HÀM HOP SERVER TỰ ĐỘNG LỌC SERVER DƯỚI 6 NGƯỜI VÀ CHỐNG LỖI 773
local function hopServer()
    isRunning = false
    StatusLabel.Text = "Hopping Server..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    
    task.wait(1.5)
    
    local Servers = {}
    local success, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if success and result and result.data then
        for _, s in ipairs(result.data) do
            if type(s) == "table" and s.playing and s.maxPlayers and s.playing >= 6 and s.playing < s.maxPlayers and s.id ~= game.JobId then
                table.insert(Servers, s.id)
            end
        end
    end
    
    if #Servers > 0 then
        local targetServer = Servers[math.random(1, #Servers)]
        local teleSuccess = false
        while not teleSuccess do
            teleSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, player)
            end)
            if not teleSuccess then
                task.wait(2)
            end
        end
    else
        local fallbackSuccess = false
        while not fallbackSuccess do
            fallbackSuccess = pcall(function()
                TeleportService:Teleport(game.PlaceId, player)
            end)
            if not fallbackSuccess then
                task.wait(3)
            end
        end
    end
    
    task.wait(5)
end

local function storeFruit(item)
    pcall(function()
        if item and item:IsA("Tool") then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rawName = item.Name:gsub(" Fruit", "")
            
            if AllBloxFruits[rawName] or string.find(item.Name, "Fruit") then
                local uniqueId = item:GetDebugId()
                if not storedFruitsCache[uniqueId] then
                    if item.Parent == player.Backpack and humanoid then
                        humanoid:EquipTool(item)
                        task.wait(0.2)
                    end
                    if remoteComm then
                        remoteComm:InvokeServer("StoreFruit", AllBloxFruits[rawName] or (rawName .. "-" .. rawName), item)
                        sendDiscordWebhook(item.Name, uniqueId)
                    end
                end
            end
        end
    end)
end

local function storeAllOwnedFruits()
    pcall(function()
        if player.Character then
            for _, item in ipairs(player.Character:GetChildren()) do storeFruit(item) end
        end
        if player:FindFirstChild("Backpack") then
            for _, item in ipairs(player:FindFirstChild("Backpack"):GetChildren()) do storeFruit(item) end
        end
    end)
end

local function autoPickAndStore()
    storeAllOwnedFruits()
    local found = false
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            local rawName = obj.Name:gsub(" Fruit", "")
            if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                local handle = obj:FindFirstChild("Handle")
                local character = player.Character
                if handle and character and character:FindFirstChild("HumanoidRootPart") then
                    StatusLabel.Text = "Fast TP: " .. obj.Name
                    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                    character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.15)
                    storeAllOwnedFruits()
                    found = true
                    break
                end
            end
        end
    end)
    return found
end

