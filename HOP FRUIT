    if verifyAccess() then
        MainFrame:TweenSize(UDim2.new(0, 290, 0, 260), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        KeyInputBox.Visible = false
        SubmitButton.Visible = false
        GetKeyButton.Visible = false
        LinkBox.Visible = false
        startMainScript()
    end
end

initializeScript()
