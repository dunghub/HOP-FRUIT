-- Thuật toán mã hóa an toàn nội bộ (Không phụ thuộc writefile nếu executor không cho phép)
local SECRET_SALT = "DUBO_SECURE_2026_X"

local function encryptData(str)
    local success, res = pcall(function()
        local encoded = ""
        for i = 1, #str do
            local b = string.byte(str, i)
            local saltB = string.byte(SECRET_SALT, (i % #SECRET_SALT) + 1)
            encoded = encoded .. string.format("%02X", bit32.bxor(b, saltB))
        end
        return string.reverse(encoded)
    end)
    return success and res or str
end

local function decryptData(str)
    local success, res = pcall(function()
        local reversed = string.reverse(str)
        local decoded = ""
        for i = 1, #reversed, 2 do
            local hex = string.sub(reversed, i, i + 1)
            local b = tonumber(hex, 16)
            if b then
                local saltB = string.byte(SECRET_SALT, (((i - 1) / 2) % #SECRET_SALT) + 1)
                decoded = decoded .. string.char(bit32.bxor(b, saltB))
            end
        end
        return decoded
    end)
    return success and res or ""
end

