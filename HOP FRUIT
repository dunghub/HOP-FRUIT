local function getLaymaShortLink(targetUrl)
    local encodedUrl = HttpService:UrlEncode(targetUrl)
    local apiUrl = string.format(
        "https://api.layma.net/api/admin/shortlink/quicklink?tokenUser=%s&format=json&url=%s&link_du_phong=%s",
        LAYMA_TOKEN, encodedUrl, encodedUrl
    )
    
    local success, res = pcall(function()
        return game:HttpGet(apiUrl)
    end)
    
    if success and res then
        local decodeSuccess, decodedData = pcall(function()
            return HttpService:JSONDecode(res)
        end)
        if decodeSuccess and decodedData and decodedData.html then
            return decodedData.html
        end
    end
    return targetUrl
end

local function verifyKey(inputKey)
    cleanupExpiredData()
    local currentHwid = getClientHWID()
    local currentTime = os.time()

    if Authorized24hPool[currentHwid] then
        if currentTime < Authorized24hPool[currentHwid] then
            return true, "Success! (Within 24h)"
        else
            Authorized24hPool[currentHwid] = nil
        end
    end

    if TemporaryKeyPool[inputKey] then
        TemporaryKeyPool[inputKey] = nil
        Authorized24hPool[currentHwid] = currentTime + (24 * 60 * 60)
        return true, "Success! Key accepted, added to 24h whitelist."
    end

    local success, response = pcall(function()
        return game:HttpGet(KEY_URL)
    end)
    if not success then return false, "GitHub Connection Error!" end
    
    local keyFound = false
    local isHwidMatched = false
    
    for line in response:gmatch("[^\r\n]+") do
        local cleanLine = line:match("^%s*(.-)%s*$")
        if cleanLine ~= "" then
            local parts = {}
            for part in cleanLine:gmatch("[^/]+") do
                table.insert(parts, part:match("^%s*(.-)%s*$"))
            end
            if parts[1] == inputKey then
                keyFound = true
                if parts[2] and parts[2] == currentHwid then
                    isHwidMatched = true
                end
                break
            end
        end
    end
    
    if not keyFound then return false, "Key does not exist or has expired!" end
    if not isHwidMatched then return false, "Admin has not configured your HWID for this key, please wait!" end
    
    return true, "Success! (Permanent Premium Key)"
end

