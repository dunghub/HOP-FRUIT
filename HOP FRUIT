local KEY_FILE_NAME = "dubo_fruit_key.json"
local PendingKeysStore = {}
local CentralHWIDStore = {}

local function getClientHWID()
    local hwid = ""
    pcall(function()
        hwid = (gethwid and gethwid()) or (RbxEnvironment and RbxEnvironment.gethwid and RbxEnvironment.gethwid()) or tostring(game:GetService("RbxAnalyticsService"):GetClientId())
    end)
    return hwid
end

local function generateRandomString(length)
    local chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    local rng = math.random
    local s = {}
    for i = 1, length do
        local randIndex = rng(1, #chars)
        table.insert(s, chars:sub(randIndex, randIndex))
    end
    return table.concat(s)
end

local function saveSavedKey(key)
    if writefile then
        pcall(function()
            local data = HttpService:JSONEncode({Key = key, Time = tick()})
            writefile(KEY_FILE_NAME, data)
        end)
    end
end

local function getSavedKey()
    if readfile and isfile and isfile(KEY_FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(KEY_FILE_NAME))
        end)
        if success and result and result.Key then
            if tick() - (result.Time or 0) < 86400 then
                return result.Key
            end
        end
    end
    return nil
end

local function generateGetKeysLink()
    local randomPart = generateRandomString(15)
    local generatedKey = "DUBO-KEY-" .. randomPart
    
    PendingKeysStore[generatedKey] = {
        hwid = getClientHWID(),
        expiresAt = tick() + 500
    }
    
    local rawLink = "https://authtool.app/get-key/?result=" .. generatedKey
    
    -- Tích hợp API Layma rút gọn link
    local tokenUser = "912b0053a34556d8ee0ac907d3149f9b"
    local encodedUrl = HttpService:UrlEncode(rawLink)
    local apiUrl = "https://api.layma.net/api/admin/shortlink/quicklink?tokenUser=" .. tokenUser .. "&format=json&url=" .. encodedUrl .. "&link_du_phong="
    
    local success, response = pcall(function()
        return game:HttpGet(apiUrl)
    end)
    
    if success then
        local decodeSuccess, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if decodeSuccess and data then
            local finalShortLink = data.short_url or data.url or data.shortened_url or data.result
            if finalShortLink then
                return finalShortLink, generatedKey
            end
        end
    end
    
    return rawLink, generatedKey
end

local function submitAndVerifyKey(inputKey)
    local currentHWID = getClientHWID()
    
    local pendingData = PendingKeysStore[inputKey]
    if pendingData then
        if tick() <= pendingData.expiresAt then
            if pendingData.hwid == currentHWID then
                CentralHWIDStore[currentHWID] = tick() + 86400
                PendingKeysStore[inputKey] = nil
                saveSavedKey(inputKey)
                return true, "Success! Key verified."
            else
                return false, "Key does not belong to this device!"
            end
        else
            PendingKeysStore[inputKey] = nil
            return false, "Key has expired!"
        end
    end
    
    return false, "Key does not exist or has expired!"
end
