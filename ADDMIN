-- Phân loại tên rương và màu sắc cho ESP
local function getChestInfo(objName)
    local lowerName = objName:lower()
    if string.find(lowerName, "diamond") then
        return "Diamond Chest", Color3.fromRGB(0, 243, 255)
    elseif string.find(lowerName, "gold") or string.find(lowerName, "golden") then
        return "Gold Chest", Color3.fromRGB(255, 215, 0)
    elseif string.find(lowerName, "silver") then
        return "Silver Chest", Color3.fromRGB(192, 192, 192)
    else
        return "Chest", Color3.fromRGB(255, 255, 255)
    end
end

-- Hệ thống ESP hiển thị tên rương
local function updateGlobalESP()
    local activeIds = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        local nameLower = obj.Name:lower()
        if string.find(nameLower, "chest") then
            local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)

            if handle then
                local uniqueId = obj:GetDebugId()
                activeIds[uniqueId] = true

                if not collectedChestsFlag[uniqueId] then
                    local chestName, chestColor = getChestInfo(obj.Name)

                    if not espCache[uniqueId] then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "GlobalChestESP"
                        billboard.Size = UDim2.new(0, 120, 0, 30)
                        billboard.StudsOffset = Vector3.new(0, 2, 0)
                        billboard.AlwaysOnTop = true
                        billboard.MaxDistance = math.huge
                        billboard.Parent = handle

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Text = chestName
                        textLabel.TextSize = 12
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextStrokeTransparency = 0.3
                        textLabel.TextColor3 = chestColor
                        textLabel.Parent = billboard

                        espCache[uniqueId] = { billboard = billboard }
                    end
                end
            end
        end
    end

    for id, data in pairs(espCache) do
        if not activeIds[id] then
            if data and data.billboard then data.billboard:Destroy() end
            espCache[id] = nil
        end
    end
end

-- Lấy rương gần nhất chưa nhặt
local function getTargetChest()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil, nil end
    local hrp = character.HumanoidRootPart

    updateGlobalESP()

    local chests = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.find(obj.Name:lower(), "chest") then
            local uniqueId = obj:GetDebugId()
            if not collectedChestsFlag[uniqueId] then
                local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if handle then
                    local dist = (hrp.Position - handle.Position).Magnitude
                    table.insert(chests, {obj = handle, id = uniqueId, dist = dist})
                end
            end
        end
    end

    if #chests == 0 then return nil, nil end

    table.sort(chests, function(a, b)
        return a.dist < b.dist
    end)

    return chests[1].obj, chests[1].id
end

-- Vòng lặp chính: Bay đến điểm -> +1 ngay -> Đứng im 0.5s -> Tiếp tục bay rương tiếp theo
task.spawn(function()
    isRunning = true
    while isRunning do
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if hrp and humanoid and humanoid.Health > 0 then
            local targetChest, uniqueId = getTargetChest()

            if targetChest and uniqueId then
                StatusLabel.Text = "Auto Chest"
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)

                local targetCFrame = targetChest.CFrame + Vector3.new(0, 3, 0)
                local distance = (hrp.Position - targetCFrame.Position).Magnitude
                local duration = math.clamp(distance / 200, 0.05, 3)

                humanoid.PlatformStand = true

                -- Bay Tween tới rương
                local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                tween:Play()
                tween.Completed:Wait()

                -- Vừa đến nơi: Đóng băng bất động và CỘNG +1 NGAY LẬP TỨC
                hrp.CFrame = targetCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.Anchored = true

                collectedChestsCount = collectedChestsCount + 1
                countLabel.Text = "Chests Collected: " .. collectedChestsCount
                
                collectedChestsFlag[uniqueId] = true
                if espCache[uniqueId] and espCache[uniqueId].billboard then
                    espCache[uniqueId].billboard:Destroy()
                    espCache[uniqueId] = nil
                end

                -- Đứng im chờ đủ 0.5 giây tại chỗ rồi mới mở khóa bay tiếp
                task.wait(0.5)

                hrp.Anchored = false
                humanoid.PlatformStand = false
            else
                StatusLabel.Text = "Not Found"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(1)
            end
        end
        task.wait(0.05)
    end
end)
