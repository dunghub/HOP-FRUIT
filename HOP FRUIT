                local minutes = math.floor((timeLeft % 3600) / 60)
                local seconds = timeLeft % 60
                
                KeyTimerLabel.Text = string.format("Key Expires: %02dh %02dm %02ds", hours, minutes, seconds)
                
                if timeLeft <= 1800 then
                    KeyTimerLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                elseif timeLeft <= 7200 then
                    KeyTimerLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
                else
                    KeyTimerLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
                end
            else
                KeyTimerLabel.Text = "Key Expired! Re-locking..."
                KeyTimerLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(1)
                pcall(function()
                    if delfile and isfile("dubo_session_S.txt") then
                        delfile("dubo_session_S.txt")
                    end
                end)
                game:GetService("TeleportService"):Teleport(game.PlaceId, player)
                break
            end
        end
        task.wait(1)
    end
end)

local function launchMainScript(targetExpireTime)
    if targetExpireTime then
        expireTimestamp = targetExpireTime
    end
    KeySystemFrame.Visible = false
    MainFrame.Visible = true
    isRunning = true
    
    task.spawn(function()
        while true do
            isRunning = true
            StatusLabel.Text = "Team: " .. factionDisplayName
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            local attempts = 0
            repeat
                pcall(function()
                    if remoteComm then
                        remoteComm:InvokeServer("SetTeam", chosenFaction)
                    end
                end)
                task.wait(1)
                attempts = attempts + 1
            until (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position.Magnitude > 50) or attempts > 12 or not isRunning

            if not isRunning then break end

            StatusLabel.Text = "Ready!"
            task.wait(0.5)

            local scanStart = tick()
            while isRunning do
                StatusLabel.Text = "Scanning..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                
                local collected = false
                pcall(function()
                    collected = autoPickAndStore()
                end)
                
                if collected then
                    scanStart = tick()
                end
                
                if not collected and (tick() - scanStart > 3) then
                    StatusLabel.Text = "Not found (Hopping...)"
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                    task.wait(0.5)
                    break
                end
                
                if not isRunning then break end
                task.wait(0.2)
            end

            if not isRunning then break end
            hopServer()
            task.wait(3)
        end
    end)
end

-- KIỂM TRA SESSION CHỐNG GIAN LẬN THỜI GIAN VÔ CỰC DO AI HOẶC HACKER TỰ CHỈNH SỬA
task.spawn(function()
    pcall(function()
        if isfile and readfile then
            if isfile("dubo_session_S.txt") then
                local content = readfile("dubo_session_S.txt")
                local parts = {}
                for part in string.gmatch(content, "[^|]+") do
                    table.insert(parts, part)
                end
                
                local isValid = false
                local targetTime = 0
                if #parts >= 3 then
                    local savedKey = decryptData(parts[1])
                    local savedHWID = decryptData(parts[2])
                    local rawTimeString = decryptData(parts[3])
                    local savedTime = tonumber(rawTimeString) or 0
                    local currentTime = os.time()
                    
                    if savedHWID == getHWID() and string.sub(savedKey, 1, 9) == "DUBO-KEY=" then
                        if savedTime > currentTime then
                            local duration = savedTime - currentTime
                            -- Chống thời gian vô cực/AI sửa số quá lớn: Key hợp lệ chỉ được phép tồn tại tối đa trong 25 giờ (90000 giây) trở lại.
                            if duration <= 90000 then
                                isValid = true
                                targetTime = savedTime
                            end
                        end
                    end
                end
                
                if isValid then
                    launchMainScript(targetTime)
                else
                    -- Phát hiện gian lận hoặc sai lệch -> Tự hủy file ngay lập tức, bắt buộc get key lại
                    pcall(function()
                        if delfile then
                            delfile("dubo_session_S.txt")
                        end
                    end)
                end
            end
        end
    end)
end)

-- XỬ LÝ NÚT GET KEY LINK (Dùng ĐÚNG 1 link API chính duy nhất, không dùng dự phòng)
GetKeyBtn.MouseButton1Click:Connect(function()
    KeyStatus.Text = "Generating secure key..."
    KeyStatus.TextColor3 = Color3.fromRGB(255, 180, 0)
    
    pcall(function()
        if delfile and isfile then
            if isfile("dubo_temp_K.txt") then delfile("dubo_temp_K.txt") end
        end
    end)
    
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local randStr = ""
    math.randomseed(tick())
    for i = 1, 20 do
        local randIdx = math.random(1, #chars)
        randStr = randStr .. string.sub(chars, randIdx, randIdx)
    end
    
    local fullKey = "DUBO-KEY=" .. randStr
    local encodedKey = encryptData(fullKey)
    
    pcall(function()
        if writefile then
            writefile("dubo_temp_K.txt", encodedKey)
        end
    end)
    
    local authtoolLink = "https://authtool.app/get-key/?result=" .. fullKey
    local laymaApiUrl = "https://api.layma.net/api/admin/shortlink/quicklink?tokenUser=912b0053a34556d8ee0ac907d3149f9b&format=json&url=" .. HttpService:UrlEncode(authtoolLink)
    
    local success, response = pcall(function()
        return game:HttpGet(laymaApiUrl)
    end)
    
    if success and response then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        
        if decodeSuccess and decoded and decoded.success and decoded.html then
            local shortlink = decoded.html
            pcall(function()
                setclipboard(shortlink)
            end)
            
            KeyStatus.Text = "Shortlink copied! Complete link to get key."
            KeyStatus.TextColor3 = Color3.fromRGB(0, 255, 120)
        else
            KeyStatus.Text = "API Error! Failed to parse response."
            KeyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    else
        KeyStatus.Text = "Network Error! Could not reach Layma API."
        KeyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

-- XỬ LÝ NÚT SUBMIT KEY
SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyInputBox.Text
    if enteredKey == "" then
        KeyStatus.Text = "Please enter your key!"
        KeyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end
    
    local isValid = false
    pcall(function()
        if isfile and readfile then
            if isfile("dubo_temp_K.txt") then
                local decryptedTempKey = decryptData(readfile("dubo_temp_K.txt"))
                if enteredKey == decryptedTempKey then
                    isValid = true
                end
            end
        end
    end)
    
    if isValid then
        pcall(function()
            if delfile and isfile("dubo_temp_K.txt") then
                delfile("dubo_temp_K.txt")
            end
        end)
        
        local calculatedExpireTime = os.time() + 86400
        pcall(function()
            if writefile then
                local encKey = encryptData(enteredKey)
                local encHWID = encryptData(getHWID())
                local encTime = encryptData(tostring(calculatedExpireTime))
                
                local finalSessionData = encKey .. "|" .. encHWID .. "|" .. encTime
                writefile("dubo_session_S.txt", finalSessionData)
            end
        end)
        
        KeyStatus.Text = "Key verified successfully!"
        KeyStatus.TextColor3 = Color3.fromRGB(0, 255, 120)
        task.wait(0.8)
        launchMainScript(calculatedExpireTime)
    else
        KeyStatus.Text = "Invalid key or temporary file missing!"
        KeyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)
