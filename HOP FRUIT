-- ==================== HỆ THỐNG XÁC THỰC KEY & HWID ====================
-- Kho 1: Kho duyệt key tạm thời (Lưu key do script tự sinh ra, hạn 500 giây)
local PendingKeysStore = {}

-- Kho 2: Kho trung tâm lưu trữ HWID đã vượt link/nhập key thành công (Hoạt động 24 giờ)
local CentralHWIDStore = {}

-- Danh sách Key Premium vĩnh viễn (Định dạng: "KEY:HWID" do chính bạn gắn HWID thủ công vào sau)
local PremiumKeyList = {
    "DUBO-VIP-EXAMPLE:CHUA_CO_HWID", -- Thay key và HWID thật của bạn vào đây
}

-- Hàm lấy HWID thiết bị của người dùng
local function getClientHWID()
    local hwid = ""
    pcall(function()
        hwid = (gethwid and gethwid()) or (RbxEnvironment and RbxEnvironment.gethwid and RbxEnvironment.gethwid()) or tostring(game:GetService("RbxAnalyticsService"):GetClientId())
    end)
    return hwid
end

-- Hàm tạo chuỗi ngẫu nhiên gồm chữ và số (15 ký tự)
local function generateRandomString(length)
    local chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    local rng = math.random
    local s = {}
    for i = 1, length do
        local randIndex = rng(1, #chars)
        table.insert(s, chars:sub(randIndex, randIndex))
    end
    return table.concat(s)
end

-- Hàm kiểm tra quyền truy cập (Dựa vào Key Premium vĩnh viễn hoặc HWID đã vượt link 24h)
local function verifyAccess(inputKey)
    local currentHWID = getClientHWID()
    
    -- 1. Kiểm tra qua Kho 2 trung tâm (HWID đã vượt link thành công trong 24 giờ qua)
    if CentralHWIDStore[currentHWID] and tick() < CentralHWIDStore[currentHWID] then
        return true
    end

    -- 2. Kiểm tra qua danh sách Key Premium vĩnh viễn do bạn tự gắn HWID
    if inputKey and inputKey ~= "" then
        for _, line in ipairs(PremiumKeyList) do
            local separatorPos = line:find(":")
            if separatorPos then
                local pKey = line:sub(1, separatorPos - 1)
                local pHWID = line:sub(separatorPos + 1)
                
                if inputKey == pKey then
                    if pHWID == "" or pHWID == "CHUA_CO_HWID" or currentHWID == pHWID then
                        return true
                    end
                end
            end
        end
    end

    return false
end

-- Hàm khi người dùng ấn Get Key: Tự sinh mã DUBO-KEY-[15 ký tự] và gắn vào link authtool.app
local function generateGetKeysLink()
    local currentHWID = getClientHWID()
    
    -- Tạo key cấu trúc: DUBO-KEY-[15 ký tự ngẫu nhiên]
    local randomPart = generateRandomString(15)
    local generatedKey = "DUBO-KEY-" .. randomPart
    
    -- Lưu vào Kho 1 với hiệu lực 500 giây
    PendingKeysStore[generatedKey] = {
        hwid = currentHWID,
        expiresAt = tick() + 500
    }
    
    -- Gắn trực tiếp key tự sinh vào đuôi link yêu cầu
    local finalLink = "https://authtool.app/get-key/?result=" .. generatedKey
    return finalLink, generatedKey
end

-- Hàm Submit Key để so khớp 1:1 với lúc script tạo ra
local function submitAndVerifyKey(inputKey)
    local currentHWID = getClientHWID()
    
    local pendingData = PendingKeysStore[inputKey]
    if pendingData then
        -- Kiểm tra thời hạn 500 giây
        if tick() <= pendingData.expiresAt then
            -- So khớp đúng thiết bị tạo key
            if pendingData.hwid == currentHWID then
                -- Khớp hoàn toàn: Cấp quyền chuyển vào Kho 2 hoạt động trong 24 giờ (86400s)
                CentralHWIDStore[currentHWID] = tick() + 86400
                -- Xóa key ở kho tạm sau khi sử dụng
                PendingKeysStore[inputKey] = nil
                return true, "Xác thực thành công! Script được phép hoạt động trong 24 giờ."
            else
                return false, "Key này không thuộc về thiết bị của bạn!"
            end
        else
            PendingKeysStore[inputKey] = nil
            return false, "Key đã hết hạn (quá 500 giây), vui lòng lấy lại key mới!"
        end
    end
    
    return false, "Sai key! Key không khớp với lúc tạo hoặc không tồn tại."
end
