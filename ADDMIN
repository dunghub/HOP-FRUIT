local collectedChestsCount = 0
local collectedChestsFlag = {} -- Cờ đánh dấu rương đã nhặt vĩnh viễn
local isRunning = true
local espCache = {}

-- Chuẩn hóa tên tiếng Anh và màu sắc các loại rương trong Blox Fruits
local function getChestInfo(objName)
    local lowerName = objName:lower()
    if string.find(lowerName, "diamond") then
        return "Diamond Chest", Color3.fromRGB(0, 243, 255) -- Xanh ngọc kim cương
    elseif string.find(lowerName, "gold") or string.find(lowerName, "golden") then
        return "Gold Chest", Color3.fromRGB(255, 215, 0) -- Vàng óng
    elseif string.find(lowerName, "silver") then
        return "Silver Chest", Color3.fromRGB(192, 192, 192) -- Bạc sáng
    else
        return "Chest", Color3.fromRGB(255, 255, 255) -- Mặc định
    end
end

-- Hệ thống ESP định vị TOÀN BỘ rương khắp nơi trên map
local function updateGlobalESP()
    local activeIds = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.find(obj.Name:lower(), "chest") then
            local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if handle then
                local uniqueId = obj:GetDebugId()
                activeIds[uniqueId] = true

                -- Nếu rương đã nhặt rồi thì xóa ESP và bỏ qua
                if collectedChestsFlag[uniqueId] then
                    if espCache[uniqueId] then
                        espCache[uniqueId]:Destroy()
                        espCache[uniqueId] = nil
                    end
                else
                    -- Chưa nhặt -> Tạo hoặc giữ nguyên ESP trên rương đó
                    local chestName, chestColor = getChestInfo(obj.Name)
                    if not espCache[uniqueId] then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "GlobalChestESP"
                        billboard.Size = UDim2.new(0, 120, 0, 35)
                        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Parent = handle

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Text = "📍 " .. chestName
                        textLabel.TextColor3 = chestColor
                        textLabel.TextSize = 11
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextStrokeTransparency = 0.4
                        textLabel.Parent = billboard

                        espCache[uniqueId] = billboard
                    end
                end
            end
        end
    end

    -- Xóa các ESP của rương không còn tồn tại trên map
    for id, esp in pairs(espCache) do
        if not activeIds[id] then
            if esp then esp:Destroy() end
            espCache[id] = nil
        end
    end
end

local function getTargetChest()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil, nil, 0, "", false end
    local hrp = character.HumanoidRootPart

    local chests = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.find(obj.Name:lower(), "chest") then
            local uniqueId = obj:GetDebugId()
            if not collectedChestsFlag[uniqueId] then
                local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    local dist = (hrp.Position - handle.Position).Magnitude
                    local cName, cColor = getChestInfo(obj.Name)
                    table.insert(chests, {obj = handle, id = uniqueId, dist = dist, name = cName})
                end
            end
        end
    end

    if #chests == 0 then return nil, nil, 0, "", false end

    -- Sắp xếp rương theo khoảng cách gần nhất
    table.sort(chests, function(a, b)
        return a.dist < b.dist
    end)

    -- Gom các rương thuộc đảo hiện tại (khoảng cách dưới 400 studs)
    local closestDist = chests[1].dist
    local currentIslandChests = {}

    for _, c in ipairs(chests) do
        if math.abs(c.dist - closestDist) < 400 or c.dist < 300 then
            table.insert(currentIslandChests, c)
        end
    end

    -- Nếu còn rương trên đảo hiện tại -> Vét tiếp (isSwitching = false)
    if #currentIslandChests > 0 then
        table.sort(currentIslandChests, function(a, b)
            return a.dist < b.dist
        end)
        return currentIslandChests[1].obj, currentIslandChests[1].id, currentIslandChests[1].dist, currentIslandChests[1].name, false
    end

    -- Hết rương đảo hiện tại -> Tiến hành chuyển đảo (isSwitching = true)
    return chests[1].obj, chests[1].id, chests[1].dist, chests[1].name, true
end

local function autoTeleportChest()
    local found = false
    pcall(function()
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        -- Cập nhật hệ thống ESP toàn bộ rương khắp map liên tục
        updateGlobalESP()

        local targetChest, uniqueId, distance, chestName, isSwitching = getTargetChest()

        if targetChest and uniqueId then
            found = true
            local targetCFrame = targetChest.CFrame + Vector3.new(0, 3, 0)
            
            -- Trạng thái UI chuẩn chỉnh:
            if isSwitching then
                StatusLabel.Text = "🔄 Island transfer\nTarget: " .. chestName .. " (" .. math.floor(distance) .. "m)"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0) -- Màu cam khi chuyển đảo
            else
                StatusLabel.Text = "✅ Target: " .. chestName .. "\nDistance: " .. math.floor(distance) .. "m"
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120) -- Màu xanh lá khi chuẩn bị đến rương trên đảo
            end

            humanoid.PlatformStand = true
            local startCFrame = hrp.CFrame
            local actualDist = (startCFrame.Position - targetCFrame.Position).Magnitude
            local speed = 300 -- Tốc độ bay chuẩn
            local duration = actualDist / speed
            local startTime = tick()

            local diedDuringTween = false
            local charDeathConn
            charDeathConn = humanoid.Died:Connect(function()
                diedDuringTween = true
                collectedChestsFlag[uniqueId] = true
            end)

            local conn
            conn = RunService.Stepped:Connect(function()
                if not isRunning or not character:FindFirstChild("HumanoidRootPart") or not targetChest.Parent or humanoid.Health <= 0 then
                    if conn then conn:Disconnect() end
                    return
                end

                -- KÍCH HOẠT NOCLIP LIÊN TỤC TRONG SUỐT QUÁ TRÌNH BAY
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then 
                        part.CanCollide = false 
                    end
                end

                local elapsed = tick() - startTime
                local alpha = math.clamp(elapsed / duration, 0, 1)
                hrp.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                if alpha >= 1 or diedDuringTween then
                    if conn then conn:Disconnect() end
                end
            end)

            task.wait(duration)
            if conn then conn:Disconnect() end
            if charDeathConn then charDeathConn:Disconnect() end
            humanoid.PlatformStand = false

            if not diedDuringTween and humanoid.Health > 0 then
                collectedChestsCount = collectedChestsCount + 1
                countLabel.Text = "Chests Collected: " .. collectedChestsCount
                
                -- Gắn cờ ẩn và xóa vĩnh viễn ESP của rương đã nhặt
                collectedChestsFlag[uniqueId] = true
                if espCache[uniqueId] then
                    espCache[uniqueId]:Destroy()
                    espCache[uniqueId] = nil
                end
            end
        end
    end)
    return found
end

task.spawn(function()
    isRunning = true
    while isRunning do
        local success = autoTeleportChest()
        if not success then
            StatusLabel.Text = "No Chests Found on Map!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            task.wait(2)
        end
        task.wait(0.2)
    end
end)
