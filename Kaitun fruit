repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local AllBloxFruits = {
    ["Rocket"] = "Rocket-Rocket", ["Spin"] = "Spin-Spin", ["Blade"] = "Blade-Blade",
    ["Spring"] = "Spring-Spring", ["Bomb"] = "Bomb-Bomb", ["Smoke"] = "Smoke-Smoke",
    ["Spike"] = "Spike-Spike", ["Flame"] = "Flame-Flame", ["Falcon"] = "Falcon-Falcon",
    ["Eagle"] = "Eagle-Eagle", ["Ice"] = "Ice-Ice", ["Sand"] = "Sand-Sand", ["Dark"] = "Dark-Dark",
    ["Diamond"] = "Diamond-Diamond", ["Light"] = "Light-Light", ["Rubber"] = "Rubber-Rubber", ["Creation"] = "Creation-Creation", ["Ghost"] = "Ghost-Ghost",
    ["Magma"] = "Magma-Magma", ["Quake"] = "Quake-Quake", ["Buddha"] = "Buddha-Buddha",
    ["Love"] = "Love-Love", ["Spider"] = "Spider-Spider", ["Sound"] = "Sound-Sound",
    ["Phoenix"] = "Phoenix-Phoenix", ["Portal"] = "Portal-Portal", ["Lightning"] = "Lightning-Linghtning",
    ["Pain"] = "Pain-Pain", ["Blizzard"] = "Blizzard-Blizzard", ["Gravity"] = "Gravity-Gravity",
    ["Dough"] = "Dough-Dough", ["Shadow"] = "Shadow-Shadow", ["Venom"] = "Venom-Venom",
    ["Control"] = "Control-Control", ["Spirit"] = "Spirit-Spirit", ["Dragon"] = "Dragon-Dragon",
    ["Tiger"] = "Tiger-Tiger", ["T-Rex"] = "T-Rex-T-Rex", ["Mammoth"] = "Mammoth-Mammoth",
    ["Kitsune"] = "Kitsune-Kitsune", ["Yeti"] = "Yeti-Yeti", ["Gas"] = "Gas-Gas",
    ["Magnet"] = "Magnet-Magnet"
}

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "FruitESPFolder"
ESPFolder.Parent = CoreGui or game:GetService("CoreGui")

RunService.RenderStepped:Connect(function()
    ESPFolder:ClearAllChildren()
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            local rawName = obj.Name:gsub(" Fruit", "")
            if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                local handle = obj:FindFirstChild("Handle")
                if handle then
                    local vector, onScreen = Camera:WorldToViewportPoint(handle.Position)
                    if onScreen then
                        local character = player.Character
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")
                        local distance = hrp and math.floor((hrp.Position - handle.Position).Magnitude) or 0

                        local ESPText = Instance.new("TextLabel")
                        ESPText.Size = UDim2.new(0, 150, 0, 30)
                        ESPText.Position = UDim2.new(0, vector.X - 75, 0, vector.Y - 20)
                        ESPText.BackgroundTransparency = 0.5
                        ESPText.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                        ESPText.TextColor3 = Color3.fromRGB(0, 255, 0)
                        ESPText.TextSize = 13
                        ESPText.Font = Enum.Font.GothamBold
                        ESPText.Text = obj.Name .. " (" .. distance .. "m)"
                        
                        local corner = Instance.new("UICorner", ESPText)
                        corner.CornerRadius = UDim.new(0, 4)
                        
                        ESPText.Parent = ESPFolder
                    end
                end
            end
        end
    end)
end)

task.spawn(function()
    while true do
        pcall(function()
            for _, obj in ipairs(Workspace:GetChildren()) do
                local rawName = obj.Name:gsub(" Fruit", "")
                if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                    local handle = obj:FindFirstChild("Handle")
                    local character = player.Character
                    if handle and character and character:FindFirstChild("HumanoidRootPart") then
                        character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.2)
                    end
                end
            end
        end)
        task.wait(0.5)
    end
end)
