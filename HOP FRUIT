local SECRET_SALT = "DUBO_ANTI_CHEAT_SECRET_2026" -- Khóa bí mật dùng để kiểm tra chữ ký
local HWID = "HWID_" .. tostring(game:GetService("RbxAnalyticsService"):GetClientId())

-- Hàm tạo mã băm đơn giản chống làm giả session
local function generateSignature(hwid, expiresAt)
    return HttpService:GenerateGUID(false) .. "_" .. tostring(hwid) .. "_" .. tostring(expiresAt) .. "_" .. string.sub(HttpService:JSONEncode({hwid, expiresAt, SECRET_SALT}), 1, 10)
end

-- Hàm kiểm tra tính hợp lệ của session (Anti-Tamper Scan)
local function checkSavedSession()
    local savedFolder = Workspace:FindFirstChild("DuboHubSession")
    if savedFolder and savedFolder:FindFirstChild("Data") then
        local rawData = savedFolder.Data.Value
        
        -- Quét xem chuỗi lưu trữ có phải là chuỗi giả mạo hoặc dạng số thô hay không
        -- Nếu không chứa đủ cấu trúc hoặc thiếu chữ ký bí mật -> Hủy ngay lập tức
        if type(rawData) ~= "string" or not string.find(rawData, HWID) then
            print("[ANTI-CHEAT] Phát hiện dữ liệu session bị làm giả hoặc sửa đổi thô! Bắt buộc lấy key lại.")
            savedFolder:Destroy()
            return false
        end

        -- Tách và kiểm tra thời hạn từ chuỗi đã mã hóa an toàn
        local success, decoded = pcall(function()
            -- Giải mã logic thời gian nằm bên trong chuỗi token
            local parts = {}
            for part in string.gmatch(rawData, "[^_]+") do
                table.insert(parts, part)
            end
            return tonumber(parts[3]) -- Lấy mốc thời gian expiresAt được nhúng ngầm
        end)

        if success and decoded then
            local timeLeft = (decoded / 1000) - os.time()
            if timeLeft > 0 then
                print("Session hợp lệ! Thời gian còn lại: " .. math.floor(timeLeft / 60) .. " phút.")
                return true
            else
                print("Session đã hết hạn.")
                savedFolder:Destroy()
            end
        else
            print("[ANTI-CHEAT] Lỗi cấu trúc chữ ký dữ liệu! Đã vô hiệu hóa.")
            savedFolder:Destroy()
        end
    end
    return false
end

