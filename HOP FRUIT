-- ================= CẤU HÌNH KẾT NỐI SERVER =================
local SERVER_URL = "https://duo-link-api.onrender.com/api/key" -- (Thay URL server của bạn vào đây)
local SECRET_AUTH_TOKEN = "YOUR_SECRET_AUTH_TOKEN_CUA_BAN" -- (Thay token bảo mật bạn đặt ở biến môi trường vào đây)

-- Tên file lưu session mã hóa ở Workspace
local SESSION_FILE = "dubohub_session.dat"

-- Hàm lấy HWID chuẩn của Executor
local function getHWID()
    local success, hwid = pcall(function()
        return gethwid and gethwid() or rbxgenguid and rbxgenguid() or "UNKNOWN_HWID"
    end)
    return success and hwid or "UNKNOWN_HWID"
end

-- Hàm mã hóa đơn giản chống nhìn lén file local (Base64 + XOR key nhẹ)
local function encryptData(data)
    local encoded = HttpService:JSONEncode(data)
    return syn and syn.crypt and syn.crypt.base64.encode(encoded) or crypt and crypt.base64encode(encoded) or game:GetService("HttpService"):JSONEncode(encoded)
end

-- Hàm giải mã dữ liệu từ file local
local function decryptData(encryptedStr)
    local success, result = pcall(function()
        local decoded = syn and syn.crypt and syn.crypt.base64.decode(encryptedStr) or crypt and crypt.base64decode(encryptedStr)
        return HttpService:JSONDecode(decoded)
    end)
    return success and result or nil
end

-- ================= KIỂM TRA SESSION CŨ (CHỐNG LẶP LẠI) =================
local function checkExistingSession()
    if pcall(function() return readfile(SESSION_FILE) end) then
        local fileContent = readfile(SESSION_FILE)
        local decrypted = decryptData(fileContent)
        if decrypted and decrypted.expireAt and decrypted.hwid == getHWID() then
            -- So sánh thời gian hiện tại với thời gian hết hạn (os.time() tính bằng giây)
            if os.time() < decrypted.expireAt then
                return true -- Vẫn còn hạn 24h, cho qua luôn không cần hiện bảng key!
            end
        end
    end
    return false
end

if checkExistingSession() then
    print("Key vẫn còn hạn, khởi chạy Hub trực tiếp...")
    -- ================= THÊM SCRIPT CHÍNH CỦA BẠN VÀO ĐÂY =================
    return
end

