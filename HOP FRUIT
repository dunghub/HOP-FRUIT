-- Kiểm tra Key trên GitHub
local function verifyKey(inputKey)
    local success, response = pcall(function()
        return game:HttpGet(KEY_URL)
    end)
    if not success then return false, "Lỗi kết nối GitHub!" end
    
    local myHWID = getHWID()
    for line in response:gmatch("[^\r\n]+") do
        local separatorPos = line:find("/")
        if separatorPos then
            local fileKey = line:sub(1, separatorPos - 1):match("^%s*(.-)%s*$")
            local fileHWID = line:sub(separatorPos + 1):match("^%s*(.-)%s*$")
            
            if fileKey == inputKey then
                if fileHWID == "" then
                    sendWebhookNotification(inputKey, myHWID)
                    return false, "Key chưa được gán HWID! Đã gửi yêu cầu về Discord."
                elseif fileHWID == myHWID then
                    return true, "Thành công!"
                else
                    return false, "Key này đang dùng ở thiết bị khác!"
                end
            end
        end
    end
    return false, "Key không tồn tại!"
end

