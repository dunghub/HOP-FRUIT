-- Fully Randomized Infinite Server Hopper Loop
local function hopServer()
    isRunning = false
    StatusLabel.Text = "Random Hopping..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    
    local success, servers = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    
    local availableServers = {}
    if success and servers and servers.data then
        for _, s in ipairs(servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                table.insert(availableServers, s.id)
            end
        end
    end
    
    if #availableServers > 0 then
        -- Shuffle / Randomize available servers array completely
        math.randomseed(tick())
        for i = #availableServers, 2, -1 do
            local j = math.random(i)
            availableServers[i], availableServers[j] = availableServers[j], availableServers[i]
        end
        
        local targetJobId = availableServers[1]
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, player)
        end)
    else
        pcall(function()
            TeleportService:Teleport(game.PlaceId, player)
        end)
    end
end

