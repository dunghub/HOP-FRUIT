-- Store Fruit Utility Function
local function storeFruit(item)
    if item and item:IsA("Tool") then
        pcall(function()
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            local rawName = item.Name:gsub(" Fruit", "")
            
            if AllBloxFruits[rawName] or string.find(item.Name, "Fruit") then
                if item.Parent == player:FindFirstChild("Backpack") and humanoid then
                    humanoid:EquipTool(item)
                    task.wait(0.25)
                end
                
                local formattedName = AllBloxFruits[rawName] or (rawName .. "-" .. rawName)
                
                remoteComm:InvokeServer("StoreFruit", formattedName, item)
            end
        end)
    end
end

-- Scan Owned Inventory & Backpack
local function storeAllOwnedFruits()
    local character = player.Character
    local currentBackpack = player:FindFirstChild("Backpack")
    
    if character then
        for _, item in ipairs(character:GetChildren()) do
            storeFruit(item)
        end
    end
    
    if currentBackpack then
        for _, item in ipairs(currentBackpack:GetChildren()) do
            storeFruit(item)
        end
    end
end

-- Ultra-Fast Teleport & Instant Pickup Function
local function autoPickAndStore()
    storeAllOwnedFruits()

    for _, obj in ipairs(Workspace:GetChildren()) do
        local rawName = obj.Name:gsub(" Fruit", "")
        if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
            local handle = obj:FindFirstChild("Handle")
            local character = player.Character
            
            if handle and character and character:FindFirstChild("HumanoidRootPart") then
                StatusLabel.Text = "Fast TP: " .. obj.Name
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                
                character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.15)
                storeAllOwnedFruits()
                return true
            end
        end
    end
    return false
end

-- Main Execution Thread with Continuous Infinite Random Hopping
task.spawn(function()
    while true do
        isRunning = true

        StatusLabel.Text = "Team: " .. factionDisplayName
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local maxSpawnAttempts = 0
        repeat
            pcall(function()
                if remoteComm then
                    remoteComm:InvokeServer("SetTeam", chosenFaction)
                end
            end)
            task.wait(1)
            maxSpawnAttempts = maxSpawnAttempts + 1
        until (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position.Magnitude > 50) or maxSpawnAttempts > 15 or not isRunning

        if not isRunning then break end

        StatusLabel.Text = "Ready!"
        task.wait(0.5)

        local scanStartTime = tick()

        while isRunning do
            StatusLabel.Text = "Scanning..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            local collected = false
            pcall(function()
                collected = autoPickAndStore()
            end)
            
            if collected then
                scanStartTime = tick()
            end
            
            if not collected and (tick() - scanStartTime > 3) then
                StatusLabel.Text = "Not found (Random Hop)"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(0.5)
                break
            end
            
            if not isRunning then break end
            task.wait(0.2)
        end

        if not isRunning then break end

        hopServer()
        task.wait(5)
    end
end)
