-- Hàm lấy HWID
local function getHWID()
    local hwid = ""
    pcall(function()
        hwid = (gethwid and gethwid()) or (syn and syn.get_hwid()) or (Fluxus and Fluxus.get_hwid()) or "UNKNOWN_HWID"
    end)
    return hwid
end

-- Hàm gửi Webhook yêu cầu gán HWID
local function sendWebhookNotification(keyInput, currentHWID)
