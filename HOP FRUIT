local function hopServer()
    isRunning = false
    StatusLabel.Text = "Hopping Server..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    
    while true do
        local servers = {}
        local success = pcall(function()
            local cursor = ""
            repeat
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                if cursor ~= "" then
                    url = url .. "&cursor=" .. cursor
                end
                local response = HttpService:JSONDecode(game:HttpGet(url))
                cursor = response.nextCursor or ""
                for _, s in ipairs(response.data) do
                    if s.playing < s.maxPlayers and s.id ~= game.JobId then
                        table.insert(servers, s.id)
                    end
                end
            until #servers >= 30 or cursor == ""
        end)

        if success and #servers > 0 then
            local randomServerId = servers[math.random(1, #servers)]
            StatusLabel.Text = "Connecting..."
            
            local teleSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServerId, Player)
            end)
            
            if teleSuccess then
                task.wait(5)
            end
        end
        
        task.wait(2)
    end
end

local function storeFruit(item)
    pcall(function()
        if item and item:IsA("Tool") then
            local character = Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rawName = item.Name:gsub(" Fruit", "")
            
            if AllBloxFruits[rawName] or string.find(item.Name, "Fruit") then
                local uniqueId = item:GetDebugId()
                if not storedFruitsCache[uniqueId] then
                    if item.Parent == Player.Backpack and humanoid then
                        humanoid:EquipTool(item)
                        task.wait(0.2)
                    end
                    if remoteComm then
                        remoteComm:InvokeServer("StoreFruit", AllBloxFruits[rawName] or (rawName .. "-" .. rawName), item)
                        sendDiscordWebhook(item.Name, uniqueId)
                    end
                end
            end
        end
    end)
end

local function storeAllOwnedFruits()
    pcall(function()
        if Player.Character then
            for _, item in ipairs(Player.Character:GetChildren()) do
                storeFruit(item)
            end
        end
        if Player:FindFirstChild("Backpack") then
            for _, item in ipairs(Player.Backpack:GetChildren()) do
                storeFruit(item)
            end
        end
    end)
end

local function autoPickAndStore()
    storeAllOwnedFruits()
    local found = false
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            local rawName = obj.Name:gsub(" Fruit", "")
            if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                local handle = obj:FindFirstChild("Handle")
                local character = Player.Character
                if handle and character and character:FindFirstChild("HumanoidRootPart") then
                    StatusLabel.Text = "Fast TP: " + obj.Name
                    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                    character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.15)
                    storeAllOwnedFruits()
                    found = true
                    break
                end
            end
        end
    end)
    return found
end

-- Vòng lặp đếm ngược thời gian key và kiểm tra hết hạn
task.spawn(function()
    while true do
        task.wait(1)
        if remainingTime > 0 then
            remainingTime = remainingTime - 1
            
            local hours = math.floor(remainingTime / 3600)
            local minutes = math.floor((remainingTime % 3600) / 60)
            local seconds = remainingTime % 60
            
            KeyTimeLabel.Text = string.format("Key Expire: %02d:%02d:%02d", hours, minutes, seconds)
            
            if remainingTime <= 0 then
                isRunning = false
                StatusLabel.Text = "Key Expired!"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                KeyTimeLabel.Text = "Key Expired! Removed."
                KeyTimeLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                
                -- Xóa file chứa key trong workspace để tránh tích tụ nhiều máy
                pcall(function()
                    if validFilePath and isfile(validFilePath) then
                        delfile(validFilePath)
                    end
                end)
                
                break
            end
        end
    end
end)

task.spawn(function()
    while true do
        if not isRunning then break end
        
        StatusLabel.Text = "Team: " .. factionDisplayName
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local attempts = 0
        repeat
            pcall(function()
                if remoteComm then
                    remoteComm:InvokeServer("SetTeam", chosenFaction)
                end
            end)
            task.wait(1)
            attempts = attempts + 1
        until (Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and Player.Character.HumanoidRootPart.Position.Magnitude > 50) or attempts > 12 or not isRunning

        if not isRunning then break end

        StatusLabel.Text = "Ready!"
        task.wait(0.5)

        local scanStart = tick()
        while isRunning do
            StatusLabel.Text = "Scanning..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            local collected = false
            pcall(function()
                collected = autoPickAndStore()
            end)
            
            if collected then
                scanStart = tick()
            end
            
            if not collected and (tick() - scanStart > 3) then
                StatusLabel.Text = "Not found (Hopping...)"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(0.5)
                break
            end
            
            if not isRunning then break end
            task.wait(0.2)
        end

        if not isRunning then break end
        hopServer()
        task.wait(3)
    end
end)
