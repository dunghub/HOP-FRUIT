local HWID = "HWID_" .. tostring(game:GetService("RbxAnalyticsService"):GetClientId())
local SECRET_SALT = "DUBO_SECRET_LOCK_2026"

local function encryptData(plainText)
    local combined = plainText .. "||" .. SECRET_SALT
    return HttpService:JSONEncode({payload = HttpService:Base64Encode(combined)})
end

local function decryptData(encryptedStr)
    local success, jsonDecoded = pcall(function()
        return HttpService:JSONDecode(encryptedStr)
    end)
    if not success or not jsonDecoded or not jsonDecoded.payload then return nil end

    local successDecode, rawText = pcall(function()
        return HttpService:Base64Decode(jsonDecoded.payload)
    end)
    if not successDecode or not rawText then return nil end

    if not string.find(rawText, SECRET_SALT) then return nil end

    local separatorPos = string.find(rawText, "||" .. SECRET_SALT)
    if not separatorPos then return nil end

    return string.sub(rawText, 1, separatorPos - 1)
end

local encryptedTargetKey = nil
local rawTargetKeyForLink = nil

local function checkSavedSession()
    local savedFolder = Workspace:FindFirstChild("DuboHubSession")
    if savedFolder and savedFolder:FindFirstChild("Data") then
        local encryptedSession = savedFolder.Data.Value
        local decryptedSessionText = decryptData(encryptedSession)
        
        if not decryptedSessionText then
            savedFolder:Destroy()
            return false
        end

        local savedHwid = string.match(decryptedSessionText, "hwid=([^&]+)")
        local savedExp = tonumber(string.match(decryptedSessionText, "exp=(%d+)"))

        if savedHwid == HWID and savedExp then
            local timeLeft = (savedExp / 1000) - os.time()
            if timeLeft > 0 then
                return true
            else
                savedFolder:Destroy()
            end
        else
            savedFolder:Destroy()
        end
    end
    return false
end

