    storeAllOwnedFruits()
    local found = false
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            local rawName = obj.Name:gsub(" Fruit", "")
            if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                local handle = obj:FindFirstChild("Handle")
                local character = player.Character
                if handle and character and character:FindFirstChild("HumanoidRootPart") then
                    -- Khi thấy fruit: Chuyển text thành màu xanh lá "Collect fruit"
                    StatusLabelHud.Text = "Collect fruit"
                    StatusLabelHud.TextColor3 = Color3.fromRGB(0, 255, 0)
                    
                    character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.15)
                    storeAllOwnedFruits()
                    found = true
                    break
                end
            end
        end
    end)
    return found
end

startMainScript = function()
    task.spawn(function()
        while isRunning do
            local attempts = 0
            repeat
                pcall(function()
                    if remoteComm then
                        remoteComm:InvokeServer("SetTeam", chosenFaction)
                    end
                end)
                task.wait(1)
                attempts = attempts + 1
            until (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position.Magnitude > 50) or attempts > 12 or not isRunning

            if not isRunning then break end

            local scanStart = tick()
            while isRunning do
                StatusLabelHud.Text = "Scanning..."
                StatusLabelHud.TextColor3 = Color3.fromRGB(255, 255, 255)
                
                local collected = false
                pcall(function()
                    collected = autoPickAndStore()
                end)
                
                if collected then
                    scanStart = tick()
                end
                
                -- Nhặt xong / Không thấy fruit: Chuyển thành "Not found"
                if not collected and (tick() - scanStart > 3) then
                    StatusLabelHud.Text = "Not found"
                    StatusLabelHud.TextColor3 = Color3.fromRGB(255, 80, 80)
                    task.wait(0.5)
                    break
                end
                
                if not isRunning then break end
                task.wait(0.2)
            end

            if not isRunning then break end
            -- Chuyển sang HOP SERVER màu cam rồi tiến hành hop server dưới 6 người
            hopServer()
            task.wait(3)
        end
    end)
end

local function initializeScript()
    local savedKey = getSavedKey()
    if savedKey and submitAndVerifyKey(savedKey) then
        KeyMainFrame.Visible = false
        MainFrame.Visible = true
        isRunning = true
        startMainScript()
    else
        KeyMainFrame.Visible = true
        MainFrame.Visible = false
        isRunning = false
    end
end

initializeScript()
