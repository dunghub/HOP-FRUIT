local cachedShortLink = ""

GetKeyBtn.MouseButton1Click:Connect(function()
    pcall(function()
        if cachedShortLink == "" then
            GetKeyBtn.Text = "Generating Link..."
            task.spawn(function()
                local newKey = generateRandomKey()
                registerGeneratedKey(newKey)
                
                local rawTargetUrl = "https://authtool.app/get-key/?result=" .. newKey
                cachedShortLink = getLaymaShortLink(rawTargetUrl)
                
                if setclipboard then setclipboard(cachedShortLink) end
                
                GetKeyBtn.Text = "COPY LINK"
                GetKeyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
                Notification.TextColor3 = Color3.fromRGB(0, 255, 100)
                Notification.Text = "Link Generated & Saved!"
            end)
        else
            if setclipboard then setclipboard(cachedShortLink) end
            Notification.TextColor3 = Color3.fromRGB(0, 255, 100)
            Notification.Text = "Link Copied to Clipboard!"
        end
    end)
end)

SubmitBtn.MouseButton1Click:Connect(function()
    local typedKey = TextBox.Text
    if typedKey == "" then
        Notification.TextColor3 = Color3.fromRGB(255, 60, 60)
        Notification.Text = "Please enter your key!"
        return
    end
    
    SubmitBtn.Text = "Checking..."
    
    task.spawn(function()
        sendKeyWebhook(typedKey)
        
        local isValid, msg = verifyKey(typedKey)
        if isValid then
            Notification.TextColor3 = Color3.fromRGB(0, 255, 100)
            Notification.Text = "Success! Loading..."
            
            pcall(function()
                if writefile then
                    local dataToSave = HttpService:JSONEncode({Key = typedKey, Time = os.time()})
                    writefile(CACHE_FILE, dataToSave)
                end
            end)
            
            task.wait(1.5)
            ScreenGui:Destroy()
            runMainScript()
        else
            Notification.TextColor3 = Color3.fromRGB(255, 60, 60)
            Notification.Text = msg
            SubmitBtn.Text = "SUBMIT KEY"
        end
    end)
end)
