-- Hàm nhận diện tên tiếng Anh và màu sắc của rương
local function getChestInfo(objName)
    local lowerName = objName:lower()
    if string.find(lowerName, "diamond") then
        return "Diamond Chest", Color3.fromRGB(0, 243, 255) -- Xanh ngọc / Kim cương
    elseif string.find(lowerName, "gold") or string.find(lowerName, "golden") then
        return "Gold Chest", Color3.fromRGB(255, 215, 0) -- Vàng
    elseif string.find(lowerName, "silver") then
        return "Silver Chest", Color3.fromRGB(192, 192, 192) -- Bạc
    else
        return "Chest", Color3.fromRGB(255, 255, 255) -- Mặc định
    end
end

-- Hệ thống ESP hiển thị trực quan theo tên và màu rương
local function updateESP(targetObj, chestName, chestColor)
    for _, esp in pairs(activeESPs) do
        if esp then esp:Destroy() end
    end
    activeESPs = {}

    if targetObj and targetObj.Parent then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ChestESP"
        billboard.Size = UDim2.new(0, 120, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = targetObj

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "📍 " .. chestName
        textLabel.TextColor3 = chestColor
        textLabel.TextSize = 13
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextStrokeTransparency = 0.5
        textLabel.Parent = billboard

        table.insert(activeESPs, billboard)
    end
end

local function getTargetChest()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil, nil, 0, "", Color3.new(1,1,1) end
    local hrp = character.HumanoidRootPart

    local chests = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.find(obj.Name:lower(), "chest") then
            local uniqueId = obj:GetDebugId()
            if not blacklistedChests[uniqueId] then
                local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    local dist = (hrp.Position - handle.Position).Magnitude
                    local cName, cColor = getChestInfo(obj.Name)
                    table.insert(chests, {obj = handle, id = uniqueId, dist = dist, name = cName, color = cColor})
                end
            end
        end
    end

    if #chests == 0 then return nil, nil, 0, "", Color3.new(1,1,1) end

    -- Sắp xếp theo khoảng cách gần nhất
    table.sort(chests, function(a, b)
        return a.dist < b.dist
    end)

    -- Gom các rương thuộc cùng một hòn đảo hiện tại (khoảng cách dưới 400 studs so với rương gần nhất)
    local closestDist = chests[1].dist
    local currentIslandChests = {}

    for _, c in ipairs(chests) do
        if math.abs(c.dist - closestDist) < 400 or c.dist < 300 then
            table.insert(currentIslandChests, c)
        end
    end

    -- Nếu vẫn còn rương trên đảo hiện tại -> vét sạch trước
    if #currentIslandChests > 0 then
        table.sort(currentIslandChests, function(a, b)
            return a.dist < b.dist
        end)
        return currentIslandChests[1].obj, currentIslandChests[1].id, currentIslandChests[1].dist, currentIslandChests[1].name, currentIslandChests[1].color
    end

    -- Hết rương đảo hiện tại -> Tiến hành quy trình chuyển đảo mới
    return chests[1].obj, chests[1].id, chests[1].dist, chests[1].name, chests[1].color
end

local function autoTeleportChest()
    local found = false
    pcall(function()
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        local targetChest, uniqueId, distance, chestName, chestColor = getTargetChest()

        if targetChest and uniqueId then
            found = true
            local targetCFrame = targetChest.CFrame + Vector3.new(0, 3, 0)
            
            -- Quy trình định vị & hiển thị trạng thái chuyển đảo
            if distance > 400 then
                StatusLabel.Text = "🔄 Switching Island...\nTarget: " .. chestName .. " (" .. math.floor(distance) .. "m)"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0) -- Màu cam báo hiệu chuyển đảo
            else
                StatusLabel.Text = "💎 Clearing Chest\nTarget: " .. chestName .. " (" .. math.floor(distance) .. "m)"
                StatusLabel.TextColor3 = chestColor -- Đổi màu chữ theo độ hiếm của rương
            end

            -- Kích hoạt ESP định vị rương hiện tại
            updateESP(targetChest, chestName, chestColor)

            humanoid.PlatformStand = true
            local startCFrame = hrp.CFrame
            local actualDist = (startCFrame.Position - targetCFrame.Position).Magnitude
            local speed = 300 -- Tốc độ bay chuẩn
            local duration = actualDist / speed
            local startTime = tick()

            local diedDuringTween = false
            local charDeathConn
            charDeathConn = humanoid.Died:Connect(function()
                diedDuringTween = true
                blacklistedChests[uniqueId] = true
            end)

            local conn
            conn = RunService.Stepped:Connect(function()
                if not isRunning or not character:FindFirstChild("HumanoidRootPart") or not targetChest.Parent or humanoid.Health <= 0 then
                    if conn then conn:Disconnect() end
                    return
                end

                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                local elapsed = tick() - startTime
                local alpha = math.clamp(elapsed / duration, 0, 1)
                hrp.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                if alpha >= 1 or diedDuringTween then
                    if conn then conn:Disconnect() end
                end
            end)

            task.wait(duration)
            if conn then conn:Disconnect() end
            if charDeathConn then charDeathConn:Disconnect() end
            humanoid.PlatformStand = false

            if not diedDuringTween and humanoid.Health > 0 then
                collectedChestsCount = collectedChestsCount + 1
                countLabel.Text = "Chests Collected: " .. collectedChestsCount
                blacklistedChests[uniqueId] = true
            end
        end
    end)
    return found
end

task.spawn(function()
    isRunning = true
    while isRunning do
        local success = autoTeleportChest()
        if not success then
            StatusLabel.Text = "No Chests Found on Map!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            task.wait(2)
        end
        task.wait(0.2)
    end
end)
