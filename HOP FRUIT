local function sendDiscordWebhook(fruitName, uniqueId)
    if not DuboCFG.WebhookURL or DuboCFG.WebhookURL == "" then return end
    if storedFruitsCache[uniqueId] then return end
    storedFruitsCache[uniqueId] = true
    
    local maskedName = "||" .. player.Name .. "||"
    local cleanFruitName = fruitName:gsub(" Fruit", "")
    local defaultImage = "https://cdn.discordapp.com/attachments/1530612413966188584/1543286088569725008/IMG_1011.png"
    local fruitImage = FruitImages[cleanFruitName] or defaultImage
    
    local data = {
        ["content"] = "@everyone",
        ["username"] = "DUBO HUB",
        ["avatar_url"] = defaultImage,
        ["embeds"] = {{
            ["color"] = 3447003,
            ["author"] = { ["name"] = "DUBO HUB Notification", ["icon_url"] = defaultImage },
            ["thumbnail"] = { ["url"] = fruitImage },
            ["fields"] = {
                { ["name"] = "Main Status", ["value"] = "Username : " .. maskedName, ["inline"] = false },
