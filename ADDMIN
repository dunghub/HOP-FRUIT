-- Chuẩn hóa tên tiếng Anh và màu sắc các loại rương
local function getChestInfo(objName)
    local lowerName = objName:lower()
    if string.find(lowerName, "diamond") then
        return "Diamond Chest", Color3.fromRGB(0, 243, 255)
    elseif string.find(lowerName, "gold") or string.find(lowerName, "golden") then
        return "Gold Chest", Color3.fromRGB(255, 215, 0)
    elseif string.find(lowerName, "silver") then
        return "Silver Chest", Color3.fromRGB(192, 192, 192)
    else
        return "Chest", Color3.fromRGB(255, 255, 255)
    end
end

local function updateGlobalESP()
    local activeIds = {}
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(Workspace:GetDescendants()) do
        local nameLower = obj.Name:lower()
        if string.find(nameLower, "chest") then
            local handle = nil
            if obj:IsA("BasePart") then
                handle = obj
            elseif obj:IsA("Model") then
                handle = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            end

            if handle then
                local uniqueId = obj:GetDebugId()
                activeIds[uniqueId] = true

                if collectedChestsFlag[uniqueId] then
                    if espCache[uniqueId] then
                        if espCache[uniqueId].billboard then
                            espCache[uniqueId].billboard:Destroy()
                        end
                        espCache[uniqueId] = nil
                    end
                else
                    local chestName, chestColor = getChestInfo(obj.Name)

                    if not espCache[uniqueId] then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "GlobalChestESP"
                        billboard.Size = UDim2.new(0, 120, 0, 30)
                        billboard.StudsOffset = Vector3.new(0, 2, 0)
                        billboard.AlwaysOnTop = true
                        billboard.MaxDistance = math.huge
                        billboard.Parent = handle

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Text = chestName -- Chỉ ghi tên rương, không icon
                        textLabel.TextSize = 12
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextStrokeTransparency = 0.3
                        textLabel.TextColor3 = chestColor
                        textLabel.Parent = billboard

                        espCache[uniqueId] = {
                            billboard = billboard,
                            part = handle
                        }
                    end
                end
            end
        end
    end

    for id, data in pairs(espCache) do
        if not activeIds[id] then
            if data and data.billboard then 
                data.billboard:Destroy() 
            end
            espCache[id] = nil
        end
    end
end

local function getTargetChest()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil, nil, 0, false end
    local hrp = character.HumanoidRootPart

    local chests = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.find(obj.Name:lower(), "chest") then
            local uniqueId = obj:GetDebugId()
            if not collectedChestsFlag[uniqueId] then
                local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if handle then
                    local dist = (hrp.Position - handle.Position).Magnitude
                    table.insert(chests, {obj = handle, id = uniqueId, dist = dist})
                end
            end
        end
    end

    if #chests == 0 then return nil, nil, 0, false end

    table.sort(chests, function(a, b)
        return a.dist < b.dist
    end)

    local closestDist = chests[1].dist
    local currentIslandChests = {}

    for _, c in ipairs(chests) do
        if math.abs(c.dist - closestDist) < 400 or c.dist < 300 then
            table.insert(currentIslandChests, c)
        end
    end

    if #currentIslandChests > 0 then
        table.sort(currentIslandChests, function(a, b)
            return a.dist < b.dist
        end)
        return currentIslandChests[1].obj, currentIslandChests[1].id, currentIslandChests[1].dist, false
    end

    return chests[1].obj, chests[1].id, chests[1].dist, true
end

local function autoTeleportChest()
    local found = false
    pcall(function()
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        updateGlobalESP()

        local targetChest, uniqueId, distance, isSwitching = getTargetChest()

        if targetChest and uniqueId then
            found = true
            local targetCFrame = targetChest.CFrame + Vector3.new(0, 3, 0)
            
            StatusLabel.Text = "Auto Chest"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)

            humanoid.PlatformStand = true
            local startCFrame = hrp.CFrame
            local actualDist = (startCFrame.Position - targetCFrame.Position).Magnitude
            local speed = 200
            local duration = actualDist / speed
            local startTime = tick()

            local diedDuringTween = false
            local charDeathConn
            charDeathConn = humanoid.Died:Connect(function()
                diedDuringTween = true
                collectedChestsFlag[uniqueId] = true
            end)

            local conn
            conn = RunService.Stepped:Connect(function()
                if not isRunning or not character:FindFirstChild("HumanoidRootPart") or not targetChest.Parent or humanoid.Health <= 0 then
                    if conn then conn:Disconnect() end
                    return
                end

                local elapsed = tick() - startTime
                local alpha = math.clamp(elapsed / duration, 0, 1)
                hrp.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                if alpha >= 1 or diedDuringTween then
                    if conn then conn:Disconnect() end
                end
            end)

            task.wait(duration)
            if conn then conn:Disconnect() end
            if charDeathConn then charDeathConn:Disconnect() end

            if not diedDuringTween and humanoid.Health > 0 and targetChest.Parent then
                hrp.CFrame = targetCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                task.wait(0.5)
                
                collectedChestsFlag[uniqueId] = true
                if espCache[uniqueId] then
                    if espCache[uniqueId].billboard then
                        espCache[uniqueId].billboard:Destroy()
                    end
                    espCache[uniqueId] = nil
                end
            end

            humanoid.PlatformStand = false
        end
    end)
    return found
end

task.spawn(function()
    isRunning = true
    while isRunning do
        local success = autoTeleportChest()
        if not success then
            StatusLabel.Text = "Not Found"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            task.wait(1)
        else
            task.wait(0.1)
        end
    end
end)
