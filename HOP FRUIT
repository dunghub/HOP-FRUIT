-- Hàm mã hóa và giải mã dữ liệu nội bộ
local function encryptData(str)
    local result = ""
    for i = 1, #str do
        local b = string.byte(str, i)
        result = result .. string.format("%02X", b + 15)
    end
    return result
end

local function decryptData(str)
    local result = ""
    pcall(function()
        for i = 1, #str, 2 do
            local hex = string.sub(str, i, i + 1)
            local b = tonumber(hex, 16)
            if b then
                result = result .. string.char(b - 15)
            end
        end
    end)
    return result
end

