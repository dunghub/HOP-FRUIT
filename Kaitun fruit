local function ServerHop()
    isRunning = false
    StatusLabel.Text = "Hopping Server..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    
    local currentPlaceId = game.PlaceId
    local currentJobId = game.JobId
    local url = "https://games.roblox.com/v1/games/" .. currentPlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= currentJobId then
                local args = { [1] = "teleport", [2] = tostring(server.id) }
                if serverBrowser then
                    local tpSuccess = pcall(function()
                        serverBrowser:InvokeServer(unpack(args))
                    end)
                    if tpSuccess then task.wait(2) return end
                else
                    local tpSuccess = pcall(function()
                        TeleportService:TeleportToPlaceInstance(currentPlaceId, tostring(server.id), player)
                    end)
                    if tpSuccess then return end
                end
            end
        end
    end
    
    pcall(function()
        if serverBrowser then
            serverBrowser:InvokeServer("teleport")
        else
            TeleportService:Teleport(currentPlaceId, player)
        end
    end)
end

local function storeFruit(item)
    pcall(function()
        if item and item:IsA("Tool") then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rawName = item.Name:gsub(" Fruit", "")
            
            if AllBloxFruits[rawName] or string.find(item.Name, "Fruit") then
                if item.Parent == player.Backpack and humanoid then
                    humanoid:EquipTool(item)
                    task.wait(0.2)
                end
                if remoteComm then
                    remoteComm:InvokeServer("StoreFruit", AllBloxFruits[rawName] or (rawName .. "-" .. rawName), item)
                end
            end
        end
    end)
end

local function storeAllOwnedFruits()
    pcall(function()
        if player.Character then
            for _, item in ipairs(player.Character:GetChildren()) do
                storeFruit(item)
            end
        end
        if player:FindFirstChild("Backpack") then
            for _, item in ipairs(player.Backpack:GetChildren()) do
                storeFruit(item)
            end
        end
    end)
end

