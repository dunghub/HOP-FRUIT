-- ================= HÀNH ĐỘNG: LẤY LINK (GENERATE) =================
GetKeyBtn.MouseButton1Click:Connect(function()
    if isCooldown then return end
    isCooldown = true

    GetKeyBtn.Text = "Đang tạo link..."
    
    local req = request or http_request or syn.request or fluxus.request
    if req then
        local success, res = pcall(function()
            return req({
                Url = SERVER_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. SECRET_AUTH_TOKEN
                },
                Body = HttpService:JSONEncode({
                    action = "generate",
                    hwid = getHWID()
                })
            })
        end)

        if success and res and res.Body then
            local data = HttpService:JSONDecode(res.Body)
            if data.status == "success" and data.shortLink then
                pcall(function() setclipboard(data.shortLink) end)
                GetKeyBtn.Text = "Đã Copy Link!"
            else
                GetKeyBtn.Text = "Lỗi Server!"
            end
        else
            GetKeyBtn.Text = "Không Kết Nối Được!"
        end
    end

    -- Chống spam cooldown 60 giây
    task.spawn(function()
        for i = 60, 1, -1 do
            GetKeyBtn.Text = "Chờ " .. i .. "s";
            task.wait(1)
        end
        GetKeyBtn.Text = "Lấy Link Key"
        isCooldown = false
    end)
end)

-- ================= HÀNH ĐỘNG: XÁC THỰC KEY (SUBMIT) =================
SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = TextBox.Text
    if enteredKey == "" then
        SubmitBtn.Text = "Chưa Nhập Key!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
        task.wait(1.5)
        SubmitBtn.Text = "Xác Nhận Key"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        return
    end

    SubmitBtn.Text = "Đang Kiểm Tra..."
    SubmitBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)

    local req = request or http_request or syn.request or fluxus.request
    local success, res = pcall(function()
        if req then
            return req({
                Url = SERVER_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. SECRET_AUTH_TOKEN
                },
                Body = HttpService:JSONEncode({
                    action = "submit",
                    hwid = getHWID(),
                    key = enteredKey
                })
            })
        end
    end)

    if success and res and res.Body then
        local data = HttpService:JSONDecode(res.Body)
        if data.status == "success" and data.expireTimestamp then
            -- Mã hóa thời gian hạn sử dụng và HWID rồi lưu xuống file local
            local sessionData = {
                hwid = getHWID(),
                expireAt = data.expireTimestamp
            }
            pcall(function()
                writefile(SESSION_FILE, encryptData(sessionData))
            end)

            SubmitBtn.Text = "Thành Công!"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            task.wait(1)
            keyPassed = true
            KeyScreen:Destroy()
            
            -- ================= GỌI SCRIPT CHÍNH Ở ĐÂY =================
            print("Đã xác thực key thành công, khởi chạy Script chính!")
        else
            SubmitBtn.Text = "Key Sai Hoặc Hết Hạn!"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            task.wait(1.5)
            SubmitBtn.Text = "Xác Nhận Key"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        end
    else
        SubmitBtn.Text = "Lỗi Kết Nối Server!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(1.5)
        SubmitBtn.Text = "Xác Nhận Key"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    end
end)

