-- Hàm dọn dẹp toàn bộ dữ liệu hết hạn (cả kho tạm lẫn kho chính)
local function cleanupExpiredData()
    local currentTime = os.time()
    
    -- Dọn dẹp kho tạm nếu quá thời hạn 500 giây mà chưa submit
    for key, data in pairs(TemporaryKeyPool) do
        if currentTime > data.expireTime then
            TemporaryKeyPool[key] = nil
        end
    end
    
    -- Dọn dẹp kho chính quá hạn 24 giờ để tiết kiệm dữ liệu và gỡ HWID
    for hwid, expireTime in pairs(Authorized24hPool) do
        if currentTime >= expireTime then
            Authorized24hPool[hwid] = nil
        end
    end
end

-- Hàm lấy chuỗi thời gian còn lại của key (để hiển thị trực tiếp lên UI)
local function getRemainingTimeText()
    cleanupExpiredData()
    local currentHwid = getClientHWID()
    local currentTime = os.time()
    
    if Authorized24hPool[currentHwid] then
        local expireTime = Authorized24hPool[currentHwid]
        local remainingSeconds = expireTime - currentTime
        
        if remainingSeconds > 0 then
            local hours = math.floor(remainingSeconds / 3600)
            local minutes = math.floor((remainingSeconds % 3600) / 60)
            local seconds = remainingSeconds % 60
            return string.format("Thời gian key còn lại: %02d:%02d:%02d", hours, minutes, seconds)
        else
            Authorized24hPool[currentHwid] = nil
        end
    end
    
    return "Trạng thái: Chưa kích hoạt hoặc đã hết hạn"
end

