-- Sự kiện bấm Submit Key: So sánh, lưu trữ vào Workspace, kích hoạt Loadstring
SubmitKeyBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyInputBox.Text
    if enteredKey == generatedKey and generatedKey ~= "" then
        isKeyVerified = true
        
        -- Lưu thông tin cấu hình vào workspace để thuận tiện cho hệ thống lưu trữ
        pcall(function()
            local folder = Workspace:FindFirstChild("DuboWorkspaceData") or Instance.new("Folder", Workspace)
            folder.Name = "DuboWorkspaceData"
            local keyVal = folder:FindFirstChild("VerifiedKey") or Instance.new("StringValue", folder)
            keyVal.Name = "VerifiedKey"
            keyVal.Value = generatedKey
        end)
        
        KeySystemFrame.Visible = false
        MainHubContent.Visible = true
        
        -- Xóa key tạm thời trong bộ nhớ đệm sau khi submit thành công để bảo mật
        generatedKey = ""
        
        -- Chạy thanh đếm ngược thời gian 24 giờ tụt dần
        task.spawn(function()
            local totalSeconds = 24 * 3600
            local startTime = tick()
            while true do
                local elapsed = tick() - startTime
                local remaining = totalSeconds - elapsed
                if remaining <= 0 then
                    isKeyVerified = false
                    MainHubContent.Visible = false
                    KeySystemFrame.Visible = true
                    KeyNotice.Text = "Key đã hết hạn sau 24 giờ! Vui lòng lấy lại key mới."
                    break
                end
                
                local hours = math.floor(remaining / 3600)
                local mins = math.floor((remaining % 3600) / 60)
                TimeText.Text = string.format("Key Time: %dh %dm left", hours, mins)
                TimeBarFill.Size = UDim2.new(remaining / totalSeconds, 0, 1, 0)
                task.wait(1)
            end
        end)
        
        -- ==================== GỌI SCRIPT CHÍNH CỦA ÔNG ====================
        task.spawn(function()
            getgenv().DuboCFG = {
                WebhookURL = "https://discord.com/api/webhooks/1543257753747988560/BWOVuk9eVhqLBdE9B9oM45eG7xrUIR7XlZg0WJloJVVXg7nD_0RxaiR78CA12hkNupsF",
                Team = "Pirates"
            }
            
            loadstring(game:HttpGet("https://raw.githubusercontent.com/dunghub/HOP-FRUIT/refs/heads/main/HOP%20FRUIT"))()
        end)
        
    else
        KeyNotice.Text = "Key không đúng hoặc bạn chưa bấm Get Key trước đó!"
        KeyNotice.TextColor3 = Color3.fromRGB(231, 76, 60)
    end
end)
