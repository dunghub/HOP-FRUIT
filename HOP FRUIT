local function getMyHWID()
    local hwid = ""
    pcall(function()
        if syn and syn.request then
            hwid = game:GetService("RbxAnalyticsService"):GetClientId()
        elseif getgenv().gethwid then
            hwid = getgenv().gethwid()
        else
            hwid = game:GetService("RbxAnalyticsService"):GetClientId()
        end
    end)
    return hwid ~= "" and hwid or "UNKNOWN_HWID"
end

local currentHWID = getMyHWID()

local function validateKeyWithServer(inputKey)
    local success, response = pcall(function()
        return game:HttpGet(GITHUB_KEY_URL)
    end)

    if not success then return false, "Lỗi kết nối đến GitHub!" end

    for line in response:gmatch("[^\r\n]+") do
        if line ~= "" then
            local parts = {}
            for part in line:gmatch("[^/]+") do
                table.insert(parts, part)
            end

            local keyOnServer = parts[1] and parts[1]:gsub("^%s*(.-)%s*$", "%1") or ""
            local hwidOnServer = parts[2] and parts[2]:gsub("^%s*(.-)%s*$", "%1") or ""

            if keyOnServer == inputKey then
                if hwidOnServer and hwidOnServer ~= "" then
                    if hwidOnServer == currentHWID then
                        return true, "Thành công"
                    else
                        return false, "Key này đã bị khóa với HWID của máy khác!"
                    end
                else
                    return true, "Thành công"
                end
            end
        end
    end

    return false, "Key does not exist or incorrect!"
end

local function checkAutoLogin()
    if isfile(LOCAL_KEY_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(LOCAL_KEY_FILE))
        end)
        
        if success and data and data.Key then
            local isValid, _ = validateKeyWithServer(data.Key)
            if isValid then
                return true, data.Key
            end
        end
    end
    return false, ""
end

