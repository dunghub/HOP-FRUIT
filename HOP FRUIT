-- Hàm kiểm tra và xác thực key hoàn chỉnh
local function verifyKey(inputKey)
    cleanupExpiredData()
    
    local currentHwid = getClientHWID()
    local currentTime = os.time()

    -- 1. Kiểm tra kho chính thức 24 giờ
    if Authorized24hPool[currentHwid] then
        if currentTime < Authorized24hPool[currentHwid] then
            return true, "Success! (Within 24h)"
        else
            Authorized24hPool[currentHwid] = nil
        end
    end

    -- 2. Kiểm tra so sánh khít từng chữ với kho tạm (trong vòng 500 giây)
    if TemporaryKeyPool[inputKey] then
        TemporaryKeyPool[inputKey] = nil -- Xóa ngay lập tức khỏi kho tạm để chống dùng ké
        Authorized24hPool[currentHwid] = currentTime + (24 * 60 * 60) -- Cấp kho chính 24h
        return true, "Success! Key accepted, added to 24h whitelist."
    end

    -- 3. Kiểm tra kho Key Premium vĩnh viễn trên GitHub (dành cho key thủ công của admin)
    local success, response = pcall(function()
        return game:HttpGet(KEY_URL)
    end)
    if not success then return false, "GitHub Connection Error!" end
    
    local keyFound = false
    local isHwidMatched = false
    
    for line in response:gmatch("[^\r\n]+") do
        local cleanLine = line:match("^%s*(.-)%s*$")
        if cleanLine ~= "" then
            local parts = {}
            for part in cleanLine:gmatch("[^/]+") do
                table.insert(parts, part:match("^%s*(.-)%s*$"))
            end
            
            local repoKey = parts[1]
            local repoHwid = parts[2]
            
            if repoKey == inputKey then
                keyFound = true
                if repoHwid and repoHwid == currentHwid then
                    isHwidMatched = true
                end
                break
            end
        end
    end
    
    if not keyFound then
        return false, "Key does not exist or has expired!"
    end
    
    if not isHwidMatched then
        return false, "Admin has not configured your HWID for this key, please wait!"
    end
    
    return true, "Success! (Permanent Premium Key)"
end

