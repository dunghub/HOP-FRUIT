local WorkspaceFolder = "DuboKeySystem"
local KEY_DURATION = 24 * 60 * 60 -- 24 giờ tính bằng giây

if not isfolder(WorkspaceFolder) then
    makefolder(WorkspaceFolder)
end

local function getValidKeyFileAndRemaining()
    local files = listfiles(WorkspaceFolder)
    local currentTime = os.time()
    
    for _, filePath in ipairs(files) do
        local fileName = filePath:match("([^/]+)$") or filePath:match("([^\\]+)$")
        if fileName and fileName:sub(1, 8) == "dubokey_" then
            local success, data = pcall(function()
                return HttpService:JSONDecode(readfile(filePath))
            end)
            if success and data and data.timestamp then
                local elapsed = currentTime - data.timestamp
                if elapsed < KEY_DURATION then
                    return filePath, (KEY_DURATION - elapsed)
                else
                    pcall(function() delfile(filePath) end)
                end
            end
        end
    end
    return nil, 0
end

