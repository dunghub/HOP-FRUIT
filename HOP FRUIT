local function hopServer()
    isRunning = false
    StatusLabel.Text = "Hopping Server..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    task.wait(1.5)
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    local Servers = {}
    if success and result and result.data then
        for _, s in ipairs(result.data) do
            if type(s) == "table" and s.playing and s.maxPlayers and s.playing >= 6 and s.playing < s.maxPlayers and s.id ~= game.JobId then
                table.insert(Servers, s.id)
            end
        end
    end
    
    if #Servers > 0 then
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, Servers[math.random(1, #Servers)], player) end)
    else
        pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
    end
    task.wait(5)
end

local function storeFruit(item)
    pcall(function()
        if item and item:IsA("Tool") then
            local rawName = item.Name:gsub(" Fruit", "")
            if AllBloxFruits[rawName] or string.find(item.Name, "Fruit") then
                local uniqueId = item:GetDebugId()
                if remoteComm then
                    remoteComm:InvokeServer("StoreFruit", AllBloxFruits[rawName] or (rawName .. "-" .. rawName), item)
                    sendDiscordWebhook(item.Name, uniqueId)
                end
            end
        end
    end)
end

local function autoPickAndStore()
    pcall(function()
        StatusLabel.Text = "Scanning..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        if player.Character then for _, item in ipairs(player.Character:GetChildren()) do storeFruit(item) end end
        if player:FindFirstChild("Backpack") then for _, item in ipairs(player.Backpack:GetChildren()) do storeFruit(item) end end
        for _, obj in ipairs(Workspace:GetChildren()) do
            local rawName = obj.Name:gsub(" Fruit", "")
            if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                local handle = obj:FindFirstChild("Handle")
                if handle and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    StatusLabel.Text = "Fast TP: " .. obj.Name
                    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                    player.Character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.15)
                    break
                end
            end
        end
    end)
end

