local collectedChests0Count = 0
local visitedPositions = {} -- Lưu các tọa độ đã ghé qua để "quên" rương cũ
local isRunning = true
local espCache = {}

-- Phân loại tên rương và màu sắc cho ESP
local function getChestInfo(objName)
    local lowerName = objName:lower()
    if string.find(lowerName, "diamond") then
        return "Diamond Chest", Color3.fromRGB(0, 243, 255)
    elseif string.find(lowerName, "gold") or string.find(lowerName, "golden") then
        return "Gold Chest", Color3.fromRGB(255, 215, 0)
    elseif string.find(lowerName, "silver") then
        return "Silver Chest", Color3.fromRGB(192, 192, 192)
    else
        return "Chest", Color3.fromRGB(255, 255, 255)
    end
end

-- Hệ thống ESP hiển thị tên rương
local function updateGlobalESP()
    local activeIds = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        local nameLower = obj.Name:lower()
        if string.find(nameLower, "chest") then
            local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)

            if handle then
                local uniqueId = obj:GetDebugId()
                local posKey = math.floor(handle.Position.X) .. "," .. math.floor(handle.Position.Y) .. "," .. math.floor(handle.Position.Z)
                activeIds[uniqueId] = true

                if not visitedPositions[posKey] then
                    local chestName, chestColor = getChestInfo(obj.Name)

                    if not espCache[uniqueId] then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "GlobalChestESP"
                        billboard.Size = UDim2.new(0, 120, 0, 30)
                        billboard.StudsOffset = Vector3.new(0, 2, 0)
                        billboard.AlwaysOnTop = true
                        billboard.MaxDistance = math.huge
                        billboard.Parent = handle

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Text = chestName
                        textLabel.TextSize = 12
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextStrokeTransparency = 0.3
                        textLabel.TextColor3 = chestColor
                        textLabel.Parent = billboard

                        espCache[uniqueId] = { billboard = billboard }
                    end
                end
            end
        end
    end

    for id, data in pairs(espCache) do
        if not activeIds[id] then
            if data and data.billboard then data.billboard:Destroy() end
            espCache[id] = nil
        end
    end
end

-- Lấy rương gần nhất dựa theo tọa độ chưa ghé thăm
local function getTargetChestPosition()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil, nil end
    local hrp = character.HumanoidRootPart

    updateGlobalESP()

    local chests = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.find(obj.Name:lower(), "chest") then
            local handle = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if handle then
                local targetPos = handle.Position + Vector3.new(0, 3, 0)
                -- Tạo khóa tọa độ (làm tròn để so sánh chính xác)
                local posKey = math.floor(targetPos.X) .. "," .. math.floor(targetPos.Y) .. "," .. math.floor(targetPos.Z)
                
                if not visitedPositions[posKey] then
                    local dist = (hrp.Position - targetPos).Magnitude
                    table.insert(chests, {pos = targetPos, key = posKey, dist = dist, obj = obj})
                end
            end
        end
    end

    if #chests == 0 then return nil, nil end

    table.sort(chests, function(a, b)
        return a.dist < b.dist
    end)

    return chests[1].pos, chests[1].key, chests[1].obj
end

-- Vòng lặp chính: Bay đến tọa độ -> +1 ngay -> Đứng im 0.5s -> Nhớ tọa độ cũ & Quên đi để bay tiếp
task.spawn(function()
    isRunning = true
    while isRunning do
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if hrp and humanoid and humanoid.Health > 0 then
            local targetPos, posKey, targetObj = getTargetChestPosition()

            if targetPos and posKey then
                StatusLabel.Text = "Auto Chest"
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)

                local distance = (hrp.Position - targetPos).Magnitude
                local duration = math.clamp(distance / 200, 0.05, 3)

                humanoid.PlatformStand = true

                -- Bay Tween đến đúng tọa độ rương
                local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
                tween:Play()
                tween.Completed:Wait()

                -- Vừa chạm tọa độ: Khóa cứng vị trí, đóng băng bất động và +1 NGAY LẬP TỨC
                hrp.CFrame = CFrame.new(targetPos)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.Anchored = true

                collectedChests0Count = collectedChests0Count + 1
                countLabel.Text = "Chests Collected: " .. collectedChests0Count
                
                -- Ghi nhớ tọa độ đã qua để không quay lại, dọn ESP của rương đó
                visitedPositions[posKey] = true
                if targetObj then
                    local uniqueId = targetObj:GetDebugId()
                    if espCache[uniqueId] and espCache[uniqueId].billboard then
                        espCache[uniqueId].billboard:Destroy()
                        espCache[uniqueId] = nil
                    end
                end

                -- Đứng im đúng 0.5 giây tại chỗ
                task.wait(0.5)

                -- Mở khóa chuẩn bị bay sang tọa độ rương mới
                hrp.Anchored = false
                humanoid.PlatformStand = false
            else
                StatusLabel.Text = "Not Found"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(1)
            end
        end
        task.wait(0.05)
    end
end)
