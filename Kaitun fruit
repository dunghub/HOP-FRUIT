local XOR_KEY = 0x65

local function encryptData(str)
    local hex = ""
    for i = 1, #str do
        local b = string.byte(str, i)
        local mixed = bit32.bxor(b, XOR_KEY)
        hex = hex .. string.format("%02X", mixed)
    end
    return string.reverse(hex)
end

local function decryptData(str)
    local success, res = pcall(function()
        local reversed = string.reverse(str)
        local result = ""
        for i = 1, #reversed, 2 do
            local hex = string.sub(reversed, i, i + 1)
            local b = tonumber(hex, 16)
            if b then
                local originalByte = bit32.bxor(b, XOR_KEY)
                result = result .. string.char(originalByte)
            end
        end
        return result
    end)
    return success and res or ""
end

