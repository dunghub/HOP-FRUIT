local function launchMainScript(targetExpireTime)
    if targetExpireTime then expireTimestamp = targetExpireTime end
    KeySystemFrame.Visible = false
    MainFrame.Visible = true
    isRunning = true
    
    task.spawn(function()
        while true do
            isRunning = true
            StatusLabel.Text = "Team: " .. factionDisplayName
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            local attempts = 0
            repeat
                pcall(function()
                    if remoteComm then remoteComm:InvokeServer("SetTeam", chosenFaction) end
                end)
                task.wait(1)
                attempts = attempts + 1
            until (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position.Magnitude > 50) or attempts > 12 or not isRunning

            if not isRunning then break end
            StatusLabel.Text = "Ready!"
            task.wait(0.5)

            local scanStart = tick()
            while isRunning do
                StatusLabel.Text = "Scanning..."
                storeAllOwnedFruits()
                local found = false
                pcall(function()
                    for _, obj in ipairs(Workspace:GetChildren()) do
                        local rawName = obj.Name:gsub(" Fruit", "")
                        if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                            local handle = obj:FindFirstChild("Handle")
                            local character = player.Character
                            if handle and character and character:FindFirstChild("HumanoidRootPart") then
                                local targetCFrame = handle.CFrame + Vector3.new(0, 3, 0)
                                StatusLabel.Text = "Tween: " .. obj.Name
                                
                                local hrp = character:FindFirstChild("HumanoidRootPart")
                                local humanoid = character:FindFirstChildOfClass("Humanoid")
                                
                                if hrp and humanoid then
                                    humanoid.PlatformStand = true
                                    local startCFrame = hrp.CFrame
                                    local distance = (startCFrame.Position - targetCFrame.Position).Magnitude
                                    local speed = 300
                                    local duration = distance / speed
                                    local startTime = tick()
                                    
                                    local conn
                                    conn = RunService.Stepped:Connect(function()
                                        if not isRunning or not character:FindFirstChild("HumanoidRootPart") then
                                            if conn then conn:Disconnect() end
                                            return
                                        end
                                        for _, part in ipairs(character:GetDescendants()) do
                                            if part:IsA("BasePart") then part.CanCollide = false end
                                        end
                                        local elapsed = tick() - startTime
                                        local alpha = math.clamp(elapsed / duration, 0, 1)
                                        hrp.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        if alpha >= 1 then if conn then conn:Disconnect() end end
                                    end)
                                    
                                    task.wait(duration)
                                    if conn then conn:Disconnect() end
                                    humanoid.PlatformStand = false
                                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                end
                                storeAllOwnedFruits()
                                found = true
                                break
                            end
                        end
                    end
                end)
                
                if found then scanStart = tick() end
                if not found and (tick() - scanStart > 3) then
                    StatusLabel.Text = "Not found (Hopping...)"
                    task.wait(0.5)
                    break
                end
                if not isRunning then break end
                task.wait(0.2)
            end

            if not isRunning then break end
            ServerHop()
            task.wait(3)
        end
    end)
end

