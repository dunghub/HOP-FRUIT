local function generateRandomKey()
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local randomString = ""
    math.randomseed(tick() + player.UserId)
    for i = 1, 20 do
        local randIndex = math.random(1, #chars)
        randomString = randomString .. chars:sub(randIndex, randIndex)
    end
    return "DUBO-KEY-" .. randomString
end

local function cleanupExpiredData()
    local currentTime = os.time()
    for key, data in pairs(TemporaryKeyPool) do
        if currentTime > data.expireTime then
            TemporaryKeyPool[key] = nil
        end
    end
    for hwid, expireTime in pairs(Authorized24hPool) do
        if currentTime >= expireTime then
            Authorized24hPool[hwid] = nil
        end
    end
end

-- Hàm kiểm tra xem key hiện tại là Premium trên GitHub hay là 24h thông thường
local function checkIsKeyPremium()
    local currentHwid = getClientHWID()
    local success, response = pcall(function()
        return game:HttpGet(KEY_URL)
    end)
    if success and response then
        for line in response:gmatch("[^\r\n]+") do
            local cleanLine = line:match("^%s*(.-)%s*$")
            if cleanLine ~= "" then
                local parts = {}
                for part in cleanLine:gmatch("[^/]+") do
                    table.insert(parts, part:match("^%s*(.-)%s*$"))
                end
                -- Nếu HWID trùng với dòng trên GitHub thì đích thị là Key Premium cấu hình vĩnh viễn
                if parts[2] and parts[2] == currentHwid then
                    return true
                end
            end
        end
    end
    return false
end

-- Hàm lấy chuỗi hiển thị ở đáy khung script (Phân biệt Premium hay 24h)
local function getActiveFooterText()
    if checkIsKeyPremium() then
        return "Trạng thái: Premium (Vĩnh viễn)"
    end

    local currentTime = os.time()
    local sessionTime = 0
    
    pcall(function()
        if readfile and isfile and isfile(CACHE_FILE) then
            local data = HttpService:JSONDecode(readfile(CACHE_FILE))
            if data and data.Time then
                sessionTime = data.Time
            end
        end
    end)
    
    local targetTime = sessionTime > 0 and sessionTime or (Authorized24hPool[getClientHWID()] and (Authorized24hPool[getClientHWID()] - 86400) or 0)
    
    if targetTime > 0 then
        local expireTime = targetTime + 86400 -- 24 giờ
        local remainingSeconds = expireTime - currentTime
        
        if remainingSeconds > 0 then
            local hours = math.floor(remainingSeconds / 3600)
            local minutes = math.floor((remainingSeconds % 3600) / 60)
            local seconds = remainingSeconds % 60
            return string.format("Thời hạn key còn lại: %02d:%02d:%02d", hours, minutes, seconds)
        end
    end
    
    return "Thời hạn key còn lại: 24:00:00"
end

