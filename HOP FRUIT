            },
            ["footer"] = { ["text"] = "DUBO HUB • " .. os.date("%H:%M - %d/%m/%Y"), ["icon_url"] = defaultImage }
        }}
    }
    
    local encodedData = HttpService:JSONEncode(data)
    pcall(function()
        local req = request or http_request or syn.request or fluxus.request
        if req then
            req({Url = DuboCFG.WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedData})
